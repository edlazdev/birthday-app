---
import { parseEventDateTime } from "@/utils/dateParser";

interface Props {
  dateStr: string; // Ej: "Viernes 31 de Julio" o "2026-07-31"
  celebrant?: string;
  timeStr?: string;
}

const { dateStr = "Viernes 31 de Julio", timeStr = "5:00 PM" } = Astro.props;

const parsed = parseEventDateTime(dateStr, timeStr);
const daysOfWeek = ["LUN", "MAR", "MIÉ", "JUE", "VIE", "SÁB", "DOM"];

const calendarCells: (number | null)[] = [];

for (let i = 0; i < parsed.startOffsetMonday; i++) {
  calendarCells.push(null);
}
for (let d = 1; d <= parsed.daysInMonth; d++) {
  calendarCells.push(d);
}
---

<div class="calendar-wrapper my-6 max-w-sm mx-auto px-2 animate-fade-up">
  <div class="calendar-card quinceanera-card p-5 text-center relative overflow-hidden">
    <div class="calendar-header mb-3">
      <span class="text-xs uppercase tracking-widest font-serif italic text-slate-300 block">
        El gran día
      </span>
      <h3 class="text-xl sm:text-2xl font-serif tracking-wider text-[var(--primary,#e79db4)] font-bold mt-0.5">
        {parsed.monthName} {parsed.year}
      </h3>
      <div class="w-12 h-0.5 bg-[var(--primary,#e79db4)]/40 mx-auto mt-2"></div>
    </div>

    {/* Rejilla de días */}
    <div class="grid grid-cols-7 gap-1 text-[10px] sm:text-xs font-semibold text-slate-400 mb-2">
      {daysOfWeek.map((day) => (
        <span class="py-1">{day}</span>
      ))}
    </div>

    <div class="grid grid-cols-7 gap-1 text-xs sm:text-sm">
      {calendarCells.map((day) => {
        if (day === null) {
          return <div class="h-8 sm:h-9"></div>;
        }
        const isTarget = day === parsed.day;
        return (
          <div class="h-8 sm:h-9 flex items-center justify-center relative">
            {isTarget ? (
              <div class="w-8 h-8 rounded-full bg-[var(--primary,#e79db4)] text-[#22242A] font-extrabold flex items-center justify-center shadow-md ring-2 ring-[var(--primary,#e79db4)]/40 scale-110">
                <span>{day}</span>
                <span class="absolute -top-1 -right-1 text-[9px]">💖</span>
              </div>
            ) : (
              <span class="text-slate-300 font-medium hover:text-white transition">
                {day}
              </span>
            )}
          </div>
        );
      })}
    </div>
  </div>
</div>

<style>
  .calendar-card {
    background-color: #22242A;
    border: 1px solid rgba(231, 157, 180, 0.3);
    border-radius: 1.5rem;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 0 15px -3px rgba(231, 157, 180, 0.1);
  }
</style>
