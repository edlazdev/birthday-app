---
export interface Props {
  tagline?: string;
  celebrant?: string;
  logoUrl?: string;
  logo?: string;
  crestFrameUrl?: string;
  monogramText?: string;
  badgeText?: string;
  primaryColor?: string;
  textColor?: string;
  textMutedColor?: string;
  borderColor?: string;
  className?: string;
}

const {
  tagline = "",
  celebrant = "",
  logoUrl = "",
  logo = "",
  crestFrameUrl = "https://gztorcrslhjeyobbykzn.supabase.co/storage/v1/object/public/freeloader-media/events/luana/marco_flores.jpg",
  monogramText = "XV",
  badgeText = "QUINCEAÑERA",
  primaryColor = "#a85d72",
  textColor = "#1f2937",
  textMutedColor = "#6b7280",
  borderColor = "#edd6dc",
  className = "",
} = Astro.props;

// Lógica de detección de logo para el nombre del evento
const isImageUrl = (str?: string) => {
  if (!str || typeof str !== "string") return false;
  const clean = str.trim();
  return (
    clean.startsWith("http://") ||
    clean.startsWith("https://") ||
    clean.startsWith("data:image/") ||
    clean.startsWith("/storage/") ||
    clean.startsWith("/images/") ||
    clean.startsWith("/") ||
    /\.(png|jpe?g|webp|svg|gif|avif)(\?.*)?$/i.test(clean)
  );
};

// Si se recibe logoUrl/logo o si celebrant fue configurado directamente como una URL de logo:
const resolvedLogoUrl = (logoUrl || logo || (isImageUrl(celebrant) ? celebrant : "")).trim();
const celebrantDisplayName = isImageUrl(celebrant) ? "" : celebrant.trim();
---

<section
  class={`event-crest-section px-4 sm:px-6 py-4 text-center select-none space-y-3 ${className}`}
  aria-label={`Monograma de ${celebrantDisplayName || monogramText || "evento"}`}
>
  <!-- 1. Pensamiento / Dedicatoria Emotiva -->
  {tagline && (
    <p
      class="quince-quote-text text-[11px] sm:text-xs leading-relaxed uppercase tracking-[0.14em] font-serif max-w-sm mx-auto"
      style={`color: ${textColor};`}
    >
      "{tagline}"
    </p>
  )}

  <!-- 2. Nombre del Celebrante en Caligrafía Script Grande o Logo Transparente -->
  {(resolvedLogoUrl || celebrantDisplayName) && (
    <div class="my-2 sm:my-3 flex justify-center items-center">
      {resolvedLogoUrl ? (
        <img
          src={resolvedLogoUrl}
          alt={celebrantDisplayName || "Logo del evento"}
          class="max-h-16 sm:max-h-20 w-auto max-w-[85%] sm:max-w-[70%] object-contain mx-auto drop-shadow-xs pointer-events-none select-none transition-all duration-300"
          loading="lazy"
        />
      ) : (
        <span
          class="quince-script-title text-4xl sm:text-5xl tracking-wide block drop-shadow-xs"
          style={`color: ${primaryColor};`}
        >
          {celebrantDisplayName}
        </span>
      )}
    </div>
  )}

  <!-- 3. Escudo Monograma XV con Marco Floral Plateado -->
  {crestFrameUrl && (
    <div class="quince-crest-container my-3 sm:my-4 flex justify-center">
      <div
        class="crest-frame relative w-60 sm:w-68 max-w-[92%] aspect-[1235/864] flex items-center justify-center"
      >
        <!-- Imagen de marco plateado con flores de fondo -->
        <img
          src={crestFrameUrl}
          alt={`Monograma ${monogramText}`}
          class="w-full h-full object-contain pointer-events-none select-none drop-shadow-xs"
          loading="lazy"
        />

        <!-- Texto central del monograma (XV, iniciales, edad) -->
        {monogramText && (
          <div
            class="absolute inset-0 flex items-center justify-center -translate-y-1 sm:-translate-y-1.5 pointer-events-none select-none"
          >
            <span
              class="quince-serif-caps text-3xl sm:text-4xl font-bold tracking-[0.16em] leading-none"
              style={`color: ${textColor};`}
            >
              {monogramText}
            </span>
          </div>
        )}
      </div>
    </div>
  )}

  <!-- 4. Badge con Líneas Sutiles ("QUINCEAÑERA", "BODA", etc.) -->
  {badgeText && (
    <div class="mt-2 mb-2">
      <span
        class="quince-serif-caps text-xs tracking-[0.3em] uppercase font-bold border-y py-1.5 px-6 inline-block"
        style={`color: ${textMutedColor}; border-color: ${borderColor};`}
      >
        {badgeText.toUpperCase()}
      </span>
    </div>
  )}
</section>

<style>
  .quince-script-title {
    font-family: var(--font-quince-script, "Great Vibes", "Alex Brush", "Pinyon Script", cursive);
  }

  .quince-serif-caps {
    font-family: var(--font-quince-serif, "Cinzel", "Playfair Display", serif);
  }

  .quince-quote-text {
    font-family: var(--font-quince-quote, "Cormorant Garamond", "Cinzel", "Playfair Display", serif);
  }
</style>
