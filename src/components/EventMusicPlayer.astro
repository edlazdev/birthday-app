---
export interface Props {
  title?: string;
  primaryColor?: string;
  accentColor?: string;
  bgColor?: string;
  borderColor?: string;
  progressPercent?: number;
  className?: string;
}

const {
  title = "DALE PLAY",
  primaryColor = "#a85d72",
  accentColor = "#d6336c",
  bgColor = "#fff8fa",
  borderColor = "#edd6dc",
  progressPercent = 40,
  className = "",
} = Astro.props;
---

<div
  class={`event-music-player quince-player-box my-4 p-3.5 rounded-2xl relative overflow-hidden max-w-[280px] mx-auto border shadow-xs select-none ${className}`}
  style={`background-color: ${bgColor}; border-color: ${borderColor};`}
  aria-label="Reproductor musical"
>
  <!-- Rizo / Lazo lateral izquierdo -->
  <span
    class="absolute left-1.5 top-1/2 -translate-y-1/2 text-xs opacity-50 select-none"
    style={`color: ${primaryColor};`}
    aria-hidden="true"
  >
    〰️
  </span>
  <!-- Rizo / Lazo lateral derecho -->
  <span
    class="absolute right-1.5 top-1/2 -translate-y-1/2 text-xs opacity-50 select-none"
    style={`color: ${primaryColor};`}
    aria-hidden="true"
  >
    〰️
  </span>

  <!-- Título del Reproductor -->
  {title && (
    <span
      class="quince-serif-caps text-[10px] tracking-[0.25em] font-bold block mb-2 text-center"
      style={`color: ${primaryColor};`}
    >
      {title}
    </span>
  )}

  <!-- Controles Play / Prev / Next -->
  <div
    class="flex items-center justify-center gap-5 text-sm"
    style={`color: ${primaryColor};`}
  >
    <button
      type="button"
      class="hover:scale-110 transition cursor-pointer opacity-70 hover:opacity-100"
      aria-label="Anterior"
    >
      ⏮
    </button>
    <button
      type="button"
      id="quince-play-btn"
      class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs text-white shadow-md hover:scale-105 active:scale-95 transition cursor-pointer"
      style={`background-color: ${accentColor}; box-shadow: 0 3px 10px rgba(214, 51, 108, 0.35);`}
      aria-label="Reproducir o pausar música"
    >
      ▶
    </button>
    <button
      type="button"
      class="hover:scale-110 transition cursor-pointer opacity-70 hover:opacity-100"
      aria-label="Siguiente"
    >
      ⏭
    </button>
  </div>

  <!-- Barra de progreso con nodo -->
  <div
    class="w-full bg-[#f0dce2] h-1 rounded-full mt-2.5 relative flex items-center"
  >
    <div
      class="h-full rounded-full transition-all duration-300"
      style={`width: ${progressPercent}%; background-color: ${primaryColor};`}
    >
    </div>
    <div
      class="w-2.5 h-2.5 rounded-full shadow-xs -ml-1 border bg-white cursor-pointer hover:scale-110 transition"
      style={`border-color: ${primaryColor};`}
    >
    </div>
  </div>
</div>

<style>
  .quince-serif-caps {
    font-family: var(--font-quince-serif, "Cinzel", "Playfair Display", serif);
  }
</style>
