---
export interface Props {
  youtubeUrl?: string;
  startSecond?: number;
  songTitle?: string;
  url?: string;
  startTime?: number;
  songName?: string;
  autoplay?: boolean;
  title?: string;
  primaryColor?: string;
  accentColor?: string;
  bgColor?: string;
  borderColor?: string;
  progressPercent?: number;
  className?: string;
}

const {
  youtubeUrl,
  startSecond,
  songTitle,
  url,
  startTime,
  songName,
  autoplay = true,
  title = "DALE PLAY",
  primaryColor = "#a85d72",
  accentColor = "#d6336c",
  bgColor = "#fff8fa",
  borderColor = "#edd6dc",
  progressPercent = 0,
  className = "",
} = Astro.props;

function extractYoutubeId(input?: string): string {
  if (!input) return "";
  const trimmed = input.trim();
  if (/^[a-zA-Z0-9_-]{11}$/.test(trimmed)) {
    return trimmed;
  }
  const match = trimmed.match(
    /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?)\/|.*[?&]v=)|youtu\.be\/|youtube\.com\/shorts\/)([^"&?\/\s]{11})/i
  );
  return match && match[1] ? match[1] : "";
}

function extractStartSecond(inputUrl?: string, explicitStart?: number): number {
  if (typeof explicitStart === "number" && !isNaN(explicitStart) && explicitStart >= 0) {
    return explicitStart;
  }
  if (!inputUrl) return 0;
  try {
    const parsed = new URL(inputUrl.startsWith("http") ? inputUrl : `https://${inputUrl}`);
    const t = parsed.searchParams.get("t") || parsed.searchParams.get("start");
    if (t) {
      if (t.endsWith("s")) return parseInt(t.replace("s", ""), 10) || 0;
      if (t.includes("m")) {
        const parts = t.split("m");
        const mins = parseInt(parts[0], 10) || 0;
        const secs = parseInt(parts[1]?.replace("s", "") || "0", 10) || 0;
        return mins * 60 + secs;
      }
      return parseInt(t, 10) || 0;
    }
  } catch {
    const match = inputUrl.match(/[?&](?:t|start)=([0-9]+)s?/i);
    if (match && match[1]) return parseInt(match[1], 10) || 0;
  }
  return 0;
}

const rawUrl = youtubeUrl || url || "";
const finalYoutubeId = extractYoutubeId(rawUrl);
const rawStart =
  startSecond !== undefined && startSecond !== null
    ? Number(startSecond)
    : startTime !== undefined && startTime !== null
      ? Number(startTime)
      : undefined;
const finalStartSecond = extractStartSecond(rawUrl, rawStart);
const finalSongTitle = (songTitle || songName || "").trim();
const instanceId = Math.random().toString(36).substring(2, 9);
const playerId = `music-player-${instanceId}`;
const ytContainerId = `yt-embed-${instanceId}`;
---

<div
  id={playerId}
  class={`event-music-player quince-player-box my-4 p-3.5 rounded-2xl relative overflow-hidden max-w-[280px] mx-auto border shadow-xs select-none transition-all duration-300 ${className}`}
  style={`background-color: ${bgColor}; border-color: ${borderColor};`}
  aria-label="Reproductor musical"
  data-player-id={playerId}
  data-youtube-id={finalYoutubeId}
  data-start-second={finalStartSecond}
  data-autoplay={autoplay ? "true" : "false"}
  data-song-title={finalSongTitle}
>
  <!-- Iframe oculto de YouTube para audio -->
  {finalYoutubeId && (
    <div
      class="youtube-audio-container pointer-events-none"
      style="position: absolute; width: 1px; height: 1px; opacity: 0.001; overflow: hidden; left: -9999px; bottom: 0;"
      aria-hidden="true"
    >
      <div id={ytContainerId}></div>
    </div>
  )}

  <!-- Rizo / Lazo lateral izquierdo -->
  <span
    class="absolute left-1.5 top-1/2 -translate-y-1/2 text-xs opacity-50 select-none pointer-events-none"
    style={`color: ${primaryColor};`}
    aria-hidden="true"
  >
    〰️
  </span>
  <!-- Rizo / Lazo lateral derecho -->
  <span
    class="absolute right-1.5 top-1/2 -translate-y-1/2 text-xs opacity-50 select-none pointer-events-none"
    style={`color: ${primaryColor};`}
    aria-hidden="true"
  >
    〰️
  </span>

  <!-- Título del Reproductor -->
  {title && (
    <span
      class="quince-serif-caps text-[10px] tracking-[0.25em] font-bold block mb-1 text-center"
      style={`color: ${primaryColor};`}
    >
      {title}
    </span>
  )}

  <!-- Nombre de la canción (con ecualizador animado) -->
  {finalSongTitle && (
    <div
      class="quince-song-badge flex items-center justify-center gap-1.5 px-2 mb-2 text-center"
      title={finalSongTitle}
    >
      <span
        class="music-note-icon text-xs inline-block transition-transform"
        style={`color: ${accentColor};`}
        aria-hidden="true"
      >
        🎵
      </span>
      <span
        class="quince-song-title text-xs font-semibold tracking-wide truncate max-w-[170px]"
        style={`color: ${primaryColor};`}
      >
        {finalSongTitle}
      </span>
      <div
        class="music-equalizer inline-flex items-end gap-[2px] h-3 ml-0.5"
        aria-hidden="true"
      >
        <span class="eq-bar eq-bar-1" style={`background-color: ${accentColor};`}></span>
        <span class="eq-bar eq-bar-2" style={`background-color: ${accentColor};`}></span>
        <span class="eq-bar eq-bar-3" style={`background-color: ${accentColor};`}></span>
      </div>
    </div>
  )}

  <!-- Controles Play / Prev / Next -->
  <div
    class="flex items-center justify-center gap-5 text-sm"
    style={`color: ${primaryColor};`}
  >
    <button
      type="button"
      class="quince-prev-btn hover:scale-110 active:scale-95 transition cursor-pointer opacity-70 hover:opacity-100 select-none"
      aria-label="Retroceder 10 segundos"
      title="Retroceder 10s"
    >
      ⏮
    </button>
    <button
      type="button"
      class="quince-play-btn w-9 h-9 rounded-full flex items-center justify-center font-bold text-xs text-white shadow-md hover:scale-105 active:scale-95 transition cursor-pointer relative select-none"
      style={`background-color: ${accentColor}; box-shadow: 0 3px 10px rgba(214, 51, 108, 0.35);`}
      aria-label="Reproducir música"
      title="Reproducir / Pausar"
    >
      <span class="quince-play-icon transition-transform">▶</span>
    </button>
    <button
      type="button"
      class="quince-next-btn hover:scale-110 active:scale-95 transition cursor-pointer opacity-70 hover:opacity-100 select-none"
      aria-label="Adelantar 10 segundos"
      title="Adelantar 10s"
    >
      ⏭
    </button>
  </div>

  <!-- Barra de progreso interactiva con nodo -->
  <div
    class="quince-progress-container w-full bg-[#f0dce2] h-1.5 rounded-full mt-2.5 relative flex items-center cursor-pointer group"
    role="slider"
    tabindex="0"
    aria-label="Progreso de la música"
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow={progressPercent}
  >
    <div
      class="quince-progress-bar h-full rounded-full transition-all duration-150 pointer-events-none"
      style={`width: ${progressPercent}%; background-color: ${primaryColor};`}
    >
    </div>
    <div
      class="quince-progress-node w-3 h-3 rounded-full shadow-xs -ml-1.5 border bg-white cursor-pointer group-hover:scale-125 transition-transform"
      style={`border-color: ${primaryColor};`}
    >
    </div>
  </div>

  <!-- Indicador de Tiempo (Actual / Total) -->
  <div
    class="quince-time-display flex justify-between items-center text-[9px] font-mono opacity-65 mt-1 px-0.5 select-none"
    style={`color: ${primaryColor};`}
  >
    <span class="quince-current-time">0:00</span>
    <span class="quince-total-time">--:--</span>
  </div>
</div>

<style>
  .quince-serif-caps {
    font-family: var(--font-quince-serif, "Cinzel", "Playfair Display", serif);
  }

  .music-equalizer .eq-bar {
    width: 2px;
    height: 3px;
    border-radius: 1px;
    transition: height 0.2s ease;
  }

  /* Animación del ecualizador cuando está reproduciendo */
  .event-music-player.is-playing .music-equalizer .eq-bar-1 {
    animation: eq-bounce 0.8s ease-in-out infinite alternate;
  }
  .event-music-player.is-playing .music-equalizer .eq-bar-2 {
    animation: eq-bounce 1.1s ease-in-out infinite alternate;
    animation-delay: 0.25s;
  }
  .event-music-player.is-playing .music-equalizer .eq-bar-3 {
    animation: eq-bounce 0.9s ease-in-out infinite alternate;
    animation-delay: 0.45s;
  }

  .event-music-player.is-playing .music-note-icon {
    animation: note-pulse 1.8s ease-in-out infinite alternate;
  }

  .event-music-player.is-playing .quince-play-btn::after {
    content: "";
    position: absolute;
    inset: -3px;
    border-radius: 9999px;
    border: 2px solid currentColor;
    opacity: 0.35;
    animation: play-pulse 2s cubic-bezier(0.4, 0, 0.6, 1) infinite;
    pointer-events: none;
  }

  @keyframes eq-bounce {
    0% {
      height: 3px;
    }
    100% {
      height: 11px;
    }
  }

  @keyframes note-pulse {
    0% {
      transform: scale(1) rotate(-3deg);
    }
    100% {
      transform: scale(1.18) rotate(6deg);
    }
  }

  @keyframes play-pulse {
    0%,
    100% {
      transform: scale(1);
      opacity: 0.35;
    }
    50% {
      transform: scale(1.18);
      opacity: 0;
    }
  }
</style>

<script>
  declare global {
    interface Window {
      YT: any;
      onYouTubeIframeAPIReady: any;
      __ytIframeReadyCallbacks?: Array<() => void>;
      __ytIframeScriptInjected?: boolean;
    }
  }

  function ensureYouTubeAPI(callback: () => void) {
    if (window.YT && window.YT.Player) {
      callback();
      return;
    }

    window.__ytIframeReadyCallbacks = window.__ytIframeReadyCallbacks || [];
    window.__ytIframeReadyCallbacks.push(callback);

    if (!window.__ytIframeScriptInjected) {
      window.__ytIframeScriptInjected = true;
      const prevCallback = window.onYouTubeIframeAPIReady;
      window.onYouTubeIframeAPIReady = () => {
        if (typeof prevCallback === "function") {
          try {
            prevCallback();
          } catch (e) {
            console.error("Previous onYouTubeIframeAPIReady error:", e);
          }
        }
        const callbacks = window.__ytIframeReadyCallbacks || [];
        callbacks.forEach((cb) => {
          try {
            cb();
          } catch (e) {
            console.error("YT callback error:", e);
          }
        });
        window.__ytIframeReadyCallbacks = [];
      };

      if (!document.querySelector('script[src*="youtube.com/iframe_api"]')) {
        const tag = document.createElement("script");
        tag.src = "https://www.youtube.com/iframe_api";
        const first = document.getElementsByTagName("script")[0];
        if (first?.parentNode) {
          first.parentNode.insertBefore(tag, first);
        } else {
          document.head.appendChild(tag);
        }
      }
    }
  }

  function formatTime(seconds: number): string {
    if (isNaN(seconds) || seconds < 0) return "0:00";
    const mins = Math.floor(seconds / 60);
    const secs = Math.floor(seconds % 60);
    return `${mins}:${secs < 10 ? "0" : ""}${secs}`;
  }

  function setupMusicPlayers() {
    const players = document.querySelectorAll<HTMLElement>(".event-music-player");

    players.forEach((playerEl) => {
      if (playerEl.dataset.initialized === "true") return;
      playerEl.dataset.initialized = "true";

      const youtubeId = playerEl.dataset.youtubeId;
      const startSecond = parseFloat(playerEl.dataset.startSecond || "0") || 0;
      const shouldAutoplay = playerEl.dataset.autoplay === "true";

      const playBtn = playerEl.querySelector<HTMLButtonElement>(".quince-play-btn");
      const playIcon = playerEl.querySelector<HTMLElement>(".quince-play-icon");
      const prevBtn = playerEl.querySelector<HTMLButtonElement>(".quince-prev-btn");
      const nextBtn = playerEl.querySelector<HTMLButtonElement>(".quince-next-btn");
      const progressContainer = playerEl.querySelector<HTMLElement>(".quince-progress-container");
      const progressBar = playerEl.querySelector<HTMLElement>(".quince-progress-bar");
      const currentTimeEl = playerEl.querySelector<HTMLElement>(".quince-current-time");
      const totalTimeEl = playerEl.querySelector<HTMLElement>(".quince-total-time");
      const ytSlot = playerEl.querySelector<HTMLElement>(".youtube-audio-container > div");

      let isPlaying = false;
      let progressInterval: number | null = null;
      let ytPlayer: any = null;
      let duration = 0;
      let userManuallyPaused = false;

      function updateProgressUI(current: number, total: number) {
        if (total > 0) {
          const percent = Math.min(100, Math.max(0, (current / total) * 100));
          if (progressBar) progressBar.style.width = `${percent}%`;
          if (progressContainer) {
            progressContainer.setAttribute("aria-valuenow", `${Math.round(percent)}`);
          }
          if (totalTimeEl) totalTimeEl.textContent = formatTime(total);
        }
        if (currentTimeEl) currentTimeEl.textContent = formatTime(current);
      }

      function setPlayingState(playing: boolean) {
        isPlaying = playing;
        if (playing) {
          playerEl.classList.add("is-playing");
          if (playIcon) playIcon.textContent = "⏸";
          if (playBtn) playBtn.setAttribute("aria-label", "Pausar música");

          if (!progressInterval) {
            progressInterval = window.setInterval(() => {
              if (ytPlayer && typeof ytPlayer.getCurrentTime === "function") {
                const curr = ytPlayer.getCurrentTime() || 0;
                const dur = ytPlayer.getDuration() || duration;
                if (dur > 0 && dur !== duration) duration = dur;
                updateProgressUI(curr, duration);
              }
            }, 350);
          }
        } else {
          playerEl.classList.remove("is-playing");
          if (playIcon) playIcon.textContent = "▶";
          if (playBtn) playBtn.setAttribute("aria-label", "Reproducir música");

          if (progressInterval) {
            clearInterval(progressInterval);
            progressInterval = null;
          }
        }
      }

      // Controles básicos
      playBtn?.addEventListener("click", () => {
        if (ytPlayer && typeof ytPlayer.playVideo === "function") {
          if (isPlaying) {
            userManuallyPaused = true;
            ytPlayer.pauseVideo();
          } else {
            userManuallyPaused = false;
            ytPlayer.playVideo();
          }
        } else {
          setPlayingState(!isPlaying);
        }
      });

      prevBtn?.addEventListener("click", () => {
        if (ytPlayer && typeof ytPlayer.getCurrentTime === "function") {
          const curr = ytPlayer.getCurrentTime() || 0;
          const target = Math.max(startSecond, curr - 10);
          ytPlayer.seekTo(target, true);
          updateProgressUI(target, duration);
        }
      });

      nextBtn?.addEventListener("click", () => {
        if (ytPlayer && typeof ytPlayer.getCurrentTime === "function") {
          const curr = ytPlayer.getCurrentTime() || 0;
          const dur = ytPlayer.getDuration() || duration;
          const target = dur > 0 ? Math.min(dur - 1, curr + 10) : curr + 10;
          ytPlayer.seekTo(target, true);
          updateProgressUI(target, dur);
        }
      });

      // Barra de progreso interactiva (click para adelantar/retroceder)
      progressContainer?.addEventListener("click", (e) => {
        if (!progressContainer) return;
        const rect = progressContainer.getBoundingClientRect();
        const clickX = e.clientX - rect.left;
        const percent = Math.max(0, Math.min(1, clickX / rect.width));

        if (ytPlayer && typeof ytPlayer.seekTo === "function" && duration > 0) {
          const targetTime = duration * percent;
          ytPlayer.seekTo(targetTime, true);
          updateProgressUI(targetTime, duration);
        } else if (progressBar) {
          progressBar.style.width = `${percent * 100}%`;
        }
      });

      // Soporte teclado para accesibilidad
      progressContainer?.addEventListener("keydown", (e) => {
        if (!ytPlayer || typeof ytPlayer.seekTo !== "function") return;
        const curr = ytPlayer.getCurrentTime() || 0;
        if (e.key === "ArrowLeft") {
          e.preventDefault();
          const target = Math.max(0, curr - 5);
          ytPlayer.seekTo(target, true);
          updateProgressUI(target, duration);
        } else if (e.key === "ArrowRight") {
          e.preventDefault();
          const target = duration > 0 ? Math.min(duration - 1, curr + 5) : curr + 5;
          ytPlayer.seekTo(target, true);
          updateProgressUI(target, duration);
        }
      });

      // Inicialización con YouTube IFrame API
      if (youtubeId && ytSlot) {
        ensureYouTubeAPI(() => {
          try {
            ytPlayer = new window.YT.Player(ytSlot.id, {
              videoId: youtubeId,
              playerVars: {
                autoplay: shouldAutoplay ? 1 : 0,
                start: startSecond > 0 ? Math.floor(startSecond) : undefined,
                controls: 0,
                disablekb: 1,
                fs: 0,
                playsinline: 1,
                rel: 0,
                enablejsapi: 1,
                origin: window.location.origin,
              },
              events: {
                onReady: (event: any) => {
                  if (startSecond > 0) {
                    try {
                      event.target.seekTo(startSecond, true);
                    } catch (e) {}
                  }

                  duration = event.target.getDuration() || 0;
                  if (duration > 0 && totalTimeEl) {
                    totalTimeEl.textContent = formatTime(duration);
                  }

                  if (shouldAutoplay) {
                    initAutoplay(event.target);
                  }
                },
                onStateChange: (event: any) => {
                  // 1 = PLAYING, 2 = PAUSED, 0 = ENDED
                  if (event.data === 1) {
                    setPlayingState(true);
                    duration = ytPlayer.getDuration() || duration;
                  } else if (event.data === 2) {
                    setPlayingState(false);
                  } else if (event.data === 0) {
                    setPlayingState(false);
                    // Bucle elegante: reiniciar desde startSecond
                    if (startSecond > 0) {
                      ytPlayer.seekTo(startSecond, true);
                    } else {
                      ytPlayer.seekTo(0, true);
                    }
                    ytPlayer.playVideo();
                  }
                },
              },
            });
          } catch (err) {
            console.error("Error al inicializar el reproductor de YouTube:", err);
          }
        });
      }

      // Gestión de reproducción automática al visualizar la página
      function initAutoplay(player: any) {
        let isStarted = false;

        const attemptPlay = () => {
          if (isStarted || userManuallyPaused) return;
          try {
            player.playVideo();
          } catch (e) {
            // Ignorar bloqueo inicial por políticas del navegador
          }
        };

        // 1. Intento inmediato al cargar
        attemptPlay();

        // 2. Si las políticas de autoplay del navegador requieren interacción del usuario,
        // escuchar el primer toque, clic o desplazamiento (scroll) en cualquier parte de la invitación
        const unlockOnUserGesture = () => {
          if (isStarted || userManuallyPaused) {
            removeGestureListeners();
            return;
          }
          attemptPlay();
          setTimeout(() => {
            const state = typeof player.getPlayerState === "function" ? player.getPlayerState() : -1;
            if (state === 1 || state === 3) {
              isStarted = true;
              removeGestureListeners();
            }
          }, 150);
        };

        const gestureEvents = ["pointerdown", "touchstart", "click", "scroll", "keydown"];
        function addGestureListeners() {
          gestureEvents.forEach((evt) => {
            window.addEventListener(evt, unlockOnUserGesture, { capture: true, once: true, passive: true });
            document.addEventListener(evt, unlockOnUserGesture, { capture: true, once: true, passive: true });
          });
        }
        function removeGestureListeners() {
          gestureEvents.forEach((evt) => {
            window.removeEventListener(evt, unlockOnUserGesture, { capture: true });
            document.removeEventListener(evt, unlockOnUserGesture, { capture: true });
          });
          document.removeEventListener("visibilitychange", onVisibilityChange);
        }

        addGestureListeners();

        // 3. Reactivar si la página pasa a primer plano (cambio de pestaña)
        const onVisibilityChange = () => {
          if (document.visibilityState === "visible" && !isStarted && !userManuallyPaused) {
            attemptPlay();
          }
        };
        document.addEventListener("visibilitychange", onVisibilityChange);

        // 4. Activar cuando el reproductor entra al viewport
        if ("IntersectionObserver" in window) {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting && !isStarted && !userManuallyPaused) {
                  attemptPlay();
                }
              });
            },
            { threshold: 0.1 }
          );
          observer.observe(playerEl);
        }
      }
    });
  }

  // Soporte para carga normal y View Transitions de Astro
  document.addEventListener("DOMContentLoaded", setupMusicPlayers);
  document.addEventListener("astro:page-load", setupMusicPlayers);
  setupMusicPlayers();
</script>
