---
import type { EventHeaderProps } from "@/types";
import Avatar from "./Avatar.astro";

type Props = EventHeaderProps;
const {
  eventData: {
    beforeCelebrant,
    showAvatar,
    slug,
    celebrant,
    title,
    age,
    afterAge,
    type,
  },
} = Astro.props;
---

<section class="event-header">
  <div class={`subtitle animate-fade-up animate-delay-2 type-${type}`}>
    {beforeCelebrant}
  </div>
  {
    showAvatar !== false && (
      <div class="event-header__avatar mt-4 animate-fade-up animate-delay-1">
        <Avatar
          slug={slug}
          showAvatar={showAvatar}
          alt={`${celebrant}, cumpleañero`}
        />
      </div>
    )
  }

  <div class="title animate-fade-up animate-delay-3">{celebrant}</div>
  <div class={`after-title animate-fade-up animate-delay-4 after-title-${type}`}>
    <span>{title}</span>
    <div class="age">{age}</div>
    <span>{afterAge}</span>
  </div>
</section>

<style>
  /* Mobile-first: Estilos base para móviles */
  .event-header {
    text-align: center;
  }

  .event-header .subtitle {
    font-family: var(--font-title, sans-serif);
    color: var(--secondary);
    margin: 0;
    line-height: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .event-header .type-wedding {
    font-weight: 700;
    padding: 3rem 0;
    font-size: 2rem;
    letter-spacing: 0;
  }

  .event-header .type-birthday {
    font-weight: 900;
    padding: 0;
    font-size: 1.25rem;
    letter-spacing: 1px;
  }

  .event-header .title {
    font-family: var(--font-title, sans-serif);
    font-weight: 900;
    color: var(--primary);
    font-size: 3rem;
    margin: 0;
    padding: 0;
    line-height: 1;
    /* letter-spacing: 1px; */
  }

  .after-title {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    color: var(--secondary);
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .after-title span {
    font-family: var(--font-text, sans-serif);
    font-weight: bold;
    color: var(--secondary);
    font-size: 1.25rem;
    margin: 0;
  }

  .after-title-wedding span{ 
    font-size: 1rem;
    padding: 3rem 0;
    letter-spacing: 2px;
    font-weight: 400;
  }

  .after-title-birthday span{ 
    font-size: 1.5rem;
    padding: 0;
    letter-spacing: 1px;
    font-weight: bold;
  }

  .age {
    font-size: 4rem;
    color: var(--tertiary);
    font-weight: bold;
    font-family: var(--font-text, sans-serif);
  }

  .after-age {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* Tablet y desktop: min-width 768px */
  @media (min-width: 768px) {
    .event-header .subtitle {
      font-size: 3rem;
      /* letter-spacing: 2px; */
    }

    .event-header .title {
      font-size: 6rem;
      /* letter-spacing: 2px; */
    }

    .after-title {
      font-size: 2rem;
    }

    .after-title span {
      font-size: 1.5rem;
    }

    .age {
      font-size: 8rem;
    }

    .after-age {
      font-size: 3rem;
    }
  }
</style>
