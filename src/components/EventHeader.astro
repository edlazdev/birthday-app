---
import type { EventHeaderProps } from "@/types";
import Avatar from "./Avatar.astro";

type Props = EventHeaderProps;
const {
  eventData: {
    beforeCelebrant,
    showAvatar,
    slug,
    celebrant,
    title,
    age,
    afterAge,
    type,
    sponsors,
    witnesses,
  },
} = Astro.props;

const showSponsors =
  type === "wedding" &&
  sponsors &&
  (sponsors.groom?.length > 0 || sponsors.bride?.length > 0);

const showWitnesses =
  type === "wedding" && witnesses && witnesses.length > 0;
---

<section class="event-header">
  <div class={`subtitle animate-fade-up animate-delay-2 type-${type}`}>
    {beforeCelebrant}
  </div>
  {
    showAvatar !== false && (
      <div class="event-header__avatar mt-4 animate-fade-up animate-delay-1">
        <Avatar
          slug={slug}
          showAvatar={showAvatar}
          alt={`${celebrant}, cumpleañero`}
        />
      </div>
    )
  }

  <div class="title animate-fade-up animate-delay-3">{celebrant}</div>
  <div class={`after-title animate-fade-up animate-delay-4 after-title-${type}`}>
    <span>{title}</span>
    <div class="age">{age}</div>
    <span>{afterAge}</span>
  </div>
  {
    showSponsors && (
      <div class="event-header__sponsors animate-fade-up animate-delay-4">
        <p class="event-header__sponsors-kicker" aria-hidden="true">
          <span class="event-header__sponsors-ornament" />
        </p>
        <p class="event-header__sponsors-intro">Nuestros padrinos</p>
        <div class="event-header__sponsors-grid">
          <div class="event-header__sponsors-col">
            <h3 class="event-header__sponsors-heading">🤵 novio</h3>
            <ul class="event-header__sponsors-list">
              {sponsors!.groom.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
          <div class="event-header__sponsors-divider" aria-hidden="true" />
          <div class="event-header__sponsors-col">
            <h3 class="event-header__sponsors-heading">👰 novia</h3>
            <ul class="event-header__sponsors-list">
              {sponsors!.bride.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )
  }
  {
    showWitnesses && (
      <div
        class:list={[
          "event-header__sponsors",
          "event-header__witnesses",
          "animate-fade-up",
          "animate-delay-4",
          { "event-header__witnesses--after-sponsors": showSponsors },
        ]}
      >
        <p class="event-header__sponsors-kicker" aria-hidden="true">
          <span class="event-header__sponsors-ornament" />
        </p>
        <p class="event-header__sponsors-intro">Nuestros testigos</p>
        <ul class="event-header__sponsors-list event-header__witnesses-list">
          {witnesses!.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  /* Mobile-first: Estilos base para móviles */
  .event-header {
    text-align: center;
  }

  .event-header .subtitle {
    font-family: var(--font-title, sans-serif);
    color: var(--secondary);
    margin: 0;
    line-height: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .event-header .type-wedding {
    font-weight: 700;
    padding: 1rem 0;
    font-size: 2rem;
    letter-spacing: 0;
  }

  .event-header .type-birthday {
    font-weight: 900;
    padding: 0;
    font-size: 1.25rem;
    letter-spacing: 1px;
  }

  .event-header .title {
    font-family: var(--font-title, sans-serif);
    font-weight: 900;
    color: var(--primary);
    font-size: 3rem;
    margin: 0;
    padding: 0;
    line-height: 1;
    /* letter-spacing: 1px; */
  }

  .after-title {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    color: var(--secondary);
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .after-title span {
    font-family: var(--font-text, sans-serif);
    font-weight: bold;
    color: var(--secondary);
    font-size: 1.25rem;
    margin: 0;
  }

  .after-title-wedding span{ 
    font-size: 1rem;
    padding: 1.5rem 0;
    letter-spacing: 2px;
    font-weight: 400;
  }

  .after-title-birthday span{ 
    font-size: 1.5rem;
    padding: 0;
    letter-spacing: 1px;
    font-weight: bold;
  }

  .event-header__sponsors {
    margin: 0 auto 0;
    max-width: 38rem;
    padding: 0 1.25rem;
  }

  .event-header__sponsors-kicker {
    margin: 0 0 0.5rem;
    display: flex;
    justify-content: center;
  }

  .event-header__sponsors-ornament {
    display: block;
    width: 8rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--primary) 55%, transparent),
      transparent
    );
  }

  .event-header__sponsors-intro {
    font-family: var(--font-title, serif);
    font-size: clamp(1.65rem, 4.2vw, 2.35rem);
    color: var(--secondary);
    margin: 0 0 1rem;
    line-height: 1.15;
    font-weight: 400;
  }

  .event-header__sponsors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.35rem;
    text-align: center;
  }

  .event-header__sponsors-divider {
    margin: 0 auto;
    width: min(12rem, 70%);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--primary) 42%, transparent),
      transparent
    );
  }

  .event-header__sponsors-heading {
    font-family: var(--font-text, sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
    margin: 0 0 0.9rem;
    line-height: 1.4;
  }

  .event-header__sponsors-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-header__sponsors-list li {
    font-family: var(--font-text, sans-serif);
    font-size: 0.9375rem;
    font-weight: 400;
    color: color-mix(in srgb, var(--secondary) 88%, transparent);
    letter-spacing: 0.035em;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .event-header__sponsors-grid {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem 2.25rem;
      align-items: start;
    }

    .event-header__sponsors-divider {
      width: 1px;
      height: auto;
      min-height: 4.5rem;
      align-self: stretch;
      margin: 0;
      background: linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, var(--primary) 38%, transparent) 20%,
        color-mix(in srgb, var(--primary) 38%, transparent) 80%,
        transparent
      );
    }
  }

  .event-header__witnesses {
    padding-top: 0.5rem;
  }

  .event-header__witnesses-list {
    margin: 0 auto;
    max-width: 22rem;
    align-items: center;
  }

  .event-header__witnesses--after-sponsors {
    margin-top: 2.25rem;
    padding-top: 0;
  }

  @media (min-width: 768px) {
    .event-header__sponsors {
      margin-top: 3.25rem;
    }

    .event-header__sponsors.event-header__witnesses--after-sponsors {
      margin-top: 2.75rem;
    }

    .event-header__sponsors-list li {
      font-size: 1.0625rem;
    }
  }

  .age {
    font-size: 4rem;
    color: var(--tertiary);
    font-weight: bold;
    font-family: var(--font-text, sans-serif);
  }

  .after-age {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* Tablet y desktop: min-width 768px */
  @media (min-width: 768px) {
    .event-header .subtitle {
      font-size: 3rem;
      /* letter-spacing: 2px; */
    }

    .event-header .title {
      font-size: 6rem;
      /* letter-spacing: 2px; */
    }

    .after-title {
      font-size: 2rem;
    }

    .after-title span {
      font-size: 1.5rem;
    }

    .age {
      font-size: 8rem;
    }

    .after-age {
      font-size: 3rem;
    }
  }
</style>
