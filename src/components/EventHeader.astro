---
import type { EventHeaderProps } from "@/types";
import Avatar from "./Avatar.astro";

type Props = EventHeaderProps;
const {
  eventData: {
    beforeCelebrant,
    showAvatar,
    avatarUrl,
    slug,
    celebrant,
    title,
    age,
    afterAge,
    type,
    sponsors,
    witnesses,
  },
} = Astro.props;

const showSponsors =
  (type === "wedding" || type === "quinceanero") &&
  sponsors &&
  (sponsors.groom?.length > 0 || sponsors.bride?.length > 0);

const showWitnesses =
  (type === "wedding" || type === "quinceanero") && witnesses && witnesses.length > 0;
---

<section class="event-header">
  <div class={`subtitle animate-fade-up animate-delay-2 type-${type}`}>
    {beforeCelebrant}
  </div>
  {
    showAvatar !== false && (
      <div class="event-header__avatar mt-4 animate-fade-up animate-delay-1">
        <Avatar
          slug={slug}
          avatarUrl={avatarUrl}
          showAvatar={showAvatar}
          alt={`${celebrant}, ${type === "wedding" ? "pareja" : type === "quinceanero" ? "quinceañera" : "festejado"}`}
        />
      </div>
    )
  }

  <div class="title animate-fade-up animate-delay-3">{celebrant}</div>
  <div class={`after-title animate-fade-up animate-delay-4 after-title-${type}`}>
    <span>{title}</span>
    <div class="age">{age}</div>
    <span>{afterAge}</span>
  </div>

  {
    type === "quinceanero" && (
      <div class="quince-crest-section my-5 animate-fade-up animate-delay-4">
        {/* Monograma Ornamental XV con Tiara */}
        <div class="quince-crest mx-auto flex flex-col items-center justify-center p-4">
          <div class="quince-crest-frame">
            <span class="text-2xl block mb-1">👑</span>
            <span class="quince-crest-letters font-serif text-3xl font-extrabold text-[var(--primary,#e79db4)] tracking-wider">
              XV
            </span>
            <span class="text-[10px] tracking-widest text-slate-300 uppercase block font-semibold mt-0.5">
              Años
            </span>
          </div>
        </div>

        {/* Reproductor de Música Decorativo "DALE PLAY" */}
        <div class="music-player-card my-4 p-3.5 max-w-xs mx-auto rounded-2xl bg-[#22242A] border border-[var(--primary,#e79db4)]/30 shadow-lg text-center">
          <span class="text-[10px] font-bold tracking-widest uppercase text-[var(--primary,#e79db4)] block mb-2">
            🎵 Dale Play
          </span>
          <div class="flex items-center justify-center gap-4 text-slate-300 text-lg">
            <button type="button" class="hover:text-[var(--primary,#e79db4)] transition cursor-pointer" aria-label="Anterior">⏮</button>
            <button type="button" class="w-10 h-10 rounded-full bg-[var(--primary,#e79db4)] text-[#22242A] flex items-center justify-center shadow-md font-bold text-base hover:scale-105 transition cursor-pointer" aria-label="Reproducir">▶</button>
            <button type="button" class="hover:text-[var(--primary,#e79db4)] transition cursor-pointer" aria-label="Siguiente">⏭</button>
          </div>
          <div class="w-full bg-slate-800 h-1.5 rounded-full mt-3 overflow-hidden">
            <div class="bg-[var(--primary,#e79db4)] h-full w-2/3 rounded-full"></div>
          </div>
        </div>

        {/* Separador de Lazo / Moño */}
        <div class="quince-ribbon-divider flex items-center justify-center gap-3 my-4 opacity-80" aria-hidden="true">
          <div class="h-px bg-gradient-to-r from-transparent via-[var(--primary,#e79db4)] to-transparent w-20"></div>
          <span class="text-xl">🎀</span>
          <div class="h-px bg-gradient-to-r from-transparent via-[var(--primary,#e79db4)] to-transparent w-20"></div>
        </div>
      </div>
    )
  }
  {
    showSponsors && (
      <div class="event-header__sponsors animate-fade-up animate-delay-4">
        <p class="event-header__sponsors-kicker" aria-hidden="true">
          <span class="event-header__sponsors-ornament" />
        </p>
        <p class="event-header__sponsors-intro">
          {type === "wedding" ? "Nuestros padrinos" : "Mis padrinos"}
        </p>
        <div class="event-header__sponsors-grid">
          <div class="event-header__sponsors-col">
            <h3 class="event-header__sponsors-heading">
              {type === "wedding" ? "🤵 novio" : "👑 padrinos"}
            </h3>
            <ul class="event-header__sponsors-list">
              {sponsors!.groom.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
          <div class="event-header__sponsors-divider" aria-hidden="true" />
          <div class="event-header__sponsors-col">
            <h3 class="event-header__sponsors-heading">
              {type === "wedding" ? "👰 novia" : "✨ acompañantes"}
            </h3>
            <ul class="event-header__sponsors-list">
              {sponsors!.bride.map((name) => (
                <li>{name}</li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    )
  }
  {
    showWitnesses && (
      <div
        class:list={[
          "event-header__sponsors",
          "event-header__witnesses",
          "animate-fade-up",
          "animate-delay-4",
          { "event-header__witnesses--after-sponsors": showSponsors },
        ]}
      >
        <p class="event-header__sponsors-kicker" aria-hidden="true">
          <span class="event-header__sponsors-ornament" />
        </p>
        <p class="event-header__sponsors-intro">Nuestros testigos</p>
        <ul class="event-header__sponsors-list event-header__witnesses-list">
          {witnesses!.map((name) => (
            <li>{name}</li>
          ))}
        </ul>
      </div>
    )
  }
</section>

<style>
  /* Mobile-first: Estilos base para móviles */
  .event-header {
    text-align: center;
  }

  .event-header .subtitle {
    font-family: var(--font-title, sans-serif);
    color: var(--secondary);
    margin: 0;
    line-height: 1;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .event-header .type-wedding {
    font-weight: 700;
    padding: 1rem 0;
    font-size: 2rem;
    letter-spacing: 0;
  }

  .event-header .type-birthday {
    font-weight: 900;
    padding: 0;
    font-size: 1.25rem;
    letter-spacing: 1px;
  }

  .event-header .title {
    font-family: var(--font-title, sans-serif);
    font-weight: 900;
    color: var(--primary);
    font-size: 3rem;
    margin: 0;
    padding: 0;
    line-height: 1;
    /* letter-spacing: 1px; */
  }

  .after-title {
    display: flex;
    flex-direction: row;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    color: var(--secondary);
    font-size: 1rem;
    font-weight: bold;
    margin: 0;
    padding: 0;
    line-height: 1;
  }

  .after-title span {
    font-family: var(--font-text, sans-serif);
    font-weight: bold;
    color: var(--secondary);
    font-size: 1.25rem;
    margin: 0;
  }

  .after-title-wedding span{ 
    font-size: 1rem;
    padding: 1.5rem 0;
    letter-spacing: 2px;
    font-weight: 400;
  }

  .after-title-birthday span{ 
    font-size: 1.5rem;
    padding: 0;
    letter-spacing: 1px;
    font-weight: bold;
  }

  .after-title-quinceanero span {
    font-size: 1.25rem;
    padding: 0.5rem 0;
    letter-spacing: 1.5px;
    font-weight: 600;
  }

  .quince-crest-frame {
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    border: 1.5px solid rgba(231, 157, 180, 0.4);
    box-shadow: 0 0 20px rgba(231, 157, 180, 0.15), inset 0 0 15px rgba(231, 157, 180, 0.08);
    background: radial-gradient(circle, #2a2c34 0%, #22242A 100%);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .quince-crest-frame::before {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px dashed rgba(231, 157, 180, 0.25);
    pointer-events: none;
  }

  .event-header__sponsors {
    margin: 0 auto 0;
    max-width: 38rem;
    padding: 0 1.25rem;
  }

  .event-header__sponsors-kicker {
    margin: 0 0 0.5rem;
    display: flex;
    justify-content: center;
  }

  .event-header__sponsors-ornament {
    display: block;
    width: 8rem;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--primary) 55%, transparent),
      transparent
    );
  }

  .event-header__sponsors-intro {
    font-family: var(--font-title, serif);
    font-size: clamp(1.65rem, 4.2vw, 2.35rem);
    color: var(--secondary);
    margin: 0 0 1rem;
    line-height: 1.15;
    font-weight: 400;
  }

  .event-header__sponsors-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.35rem;
    text-align: center;
  }

  .event-header__sponsors-divider {
    margin: 0 auto;
    width: min(12rem, 70%);
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      color-mix(in srgb, var(--primary) 42%, transparent),
      transparent
    );
  }

  .event-header__sponsors-heading {
    font-family: var(--font-text, sans-serif);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--primary);
    margin: 0 0 0.9rem;
    line-height: 1.4;
  }

  .event-header__sponsors-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .event-header__sponsors-list li {
    font-family: var(--font-text, sans-serif);
    font-size: 0.9375rem;
    font-weight: 400;
    color: color-mix(in srgb, var(--secondary) 88%, transparent);
    letter-spacing: 0.035em;
    line-height: 1.5;
  }

  @media (min-width: 640px) {
    .event-header__sponsors-grid {
      grid-template-columns: 1fr auto 1fr;
      gap: 1.5rem 2.25rem;
      align-items: start;
    }

    .event-header__sponsors-divider {
      width: 1px;
      height: auto;
      min-height: 4.5rem;
      align-self: stretch;
      margin: 0;
      background: linear-gradient(
        180deg,
        transparent,
        color-mix(in srgb, var(--primary) 38%, transparent) 20%,
        color-mix(in srgb, var(--primary) 38%, transparent) 80%,
        transparent
      );
    }
  }

  .event-header__witnesses {
    padding-top: 0.5rem;
  }

  .event-header__witnesses-list {
    margin: 0 auto;
    max-width: 22rem;
    align-items: center;
  }

  .event-header__witnesses--after-sponsors {
    margin-top: 2.25rem;
    padding-top: 0;
  }

  @media (min-width: 768px) {
    .event-header__sponsors {
      margin-top: 3.25rem;
    }

    .event-header__sponsors.event-header__witnesses--after-sponsors {
      margin-top: 2.75rem;
    }

    .event-header__sponsors-list li {
      font-size: 1.0625rem;
    }
  }

  .age {
    font-size: 4rem;
    color: var(--tertiary);
    font-weight: bold;
    font-family: var(--font-text, sans-serif);
  }

  .after-age {
    font-size: 1.5rem;
    font-weight: bold;
  }

  /* Tablet y desktop: min-width 768px */
  @media (min-width: 768px) {
    .event-header .subtitle {
      font-size: 3rem;
      /* letter-spacing: 2px; */
    }

    .event-header .title {
      font-size: 6rem;
      /* letter-spacing: 2px; */
    }

    .after-title {
      font-size: 2rem;
    }

    .after-title span {
      font-size: 1.5rem;
    }

    .age {
      font-size: 8rem;
    }

    .after-age {
      font-size: 3rem;
    }
  }
</style>
