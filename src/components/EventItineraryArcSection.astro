                            <path d="M50,16 C46,10 39,15 42,21 C45,26 50,32 50,32 C50,32 55,26 58,21 C61,15 54,10 50,16 Z" fill={archBg} />
                            <circle cx="50" cy="22" r="3" fill="#ffffff" />
