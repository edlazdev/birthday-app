---
export interface ItineraryItem {
  time: string;
  title: string;
  description?: string;
  icon?: string;
}

export interface Props {
  itinerary?: ItineraryItem[];
  title?: string;
  subtitle?: string;
  archBg?: string;
  textColor?: string;
  lineColor?: string;
  className?: string;
}

const {
  itinerary = [],
  title = "Itinerario",
  subtitle = "Actividades",
  archBg = "#c78596",
  textColor = "#ffffff",
  lineColor = "rgba(255, 255, 255, 0.85)",
  className = "",
} = Astro.props;

// Normalizar lista de actividades
const cleanItems = (itinerary || []).filter(
  (item) => item && (item.title || item.time)
);

// Helper para determinar el tipo de ícono metálico plateado
function resolveIconType(item: ItineraryItem): string {
  const icon = (item.icon || "").trim().toLowerCase();
  const title = (item.title || "").toLowerCase();

  if (icon === "👑" || title.includes("corona") || title.includes("tiara") || title.includes("quinceañera") || title.includes("entrada") || title.includes("presentación")) {
    return "crown";
  }
  if (icon === "🍽️" || icon === "🍽" || icon === "🍴" || title.includes("comida") || title.includes("cena") || title.includes("banquete") || title.includes("almuerzo") || title.includes("buffet")) {
    return "dinner";
  }
  if (icon === "⛪" || icon === "✝️" || icon === "⛪️" || title.includes("misa") || title.includes("iglesia") || title.includes("ceremonia") || title.includes("religiosa") || title.includes("capilla")) {
    return "church";
  }
  if (icon === "💃" || icon === "🕺" || icon === "🏰" || title.includes("vals") || title.includes("baile") || title.includes("danza") || title.includes("fiesta") || title.includes("pista") || title.includes("protocolo")) {
    return "waltz";
  }
  if (icon === "🥂" || icon === "🍾" || icon === "🍷" || title.includes("brindis") || title.includes("recepción") || title.includes("bienvenida") || title.includes("cóctel") || title.includes("coctel")) {
    return "toast";
  }
  if (icon === "👠" || title.includes("zapatilla") || title.includes("tacón") || title.includes("calzado")) {
    return "slipper";
  }
  if (icon === "📸" || icon === "📷" || title.includes("foto") || title.includes("sesión")) {
    return "camera";
  }
  if (icon === "🎂" || icon === "🍰" || title.includes("torta") || title.includes("pastel") || title.includes("cumpleaños")) {
    return "cake";
  }
  return "custom";
}
---

{cleanItems.length > 0 && (
  <div class={`event-itinerary-arc-section w-full max-w-[390px] sm:max-w-[420px] mx-auto py-2 ${className}`}>
    <!-- Definiciones SVG Compartidas de Gradientes Plateados Metálicos con Relieve -->
    <svg width="0" height="0" class="absolute pointer-events-none" aria-hidden="true">
      <defs>
        <linearGradient id="silver-metallic-shine" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#ffffff" />
          <stop offset="20%" stop-color="#eef2f6" />
          <stop offset="45%" stop-color="#cad2dc" />
          <stop offset="70%" stop-color="#8f99a8" />
          <stop offset="85%" stop-color="#e8ecf1" />
          <stop offset="100%" stop-color="#737e8e" />
        </linearGradient>
        <radialGradient id="silver-metallic-rim" cx="50%" cy="50%" r="50%">
          <stop offset="0%" stop-color="#e2e7ec" />
          <stop offset="55%" stop-color="#b0b8c4" />
          <stop offset="85%" stop-color="#ffffff" />
          <stop offset="100%" stop-color="#7a8494" />
        </radialGradient>
      </defs>
    </svg>

    <!-- La Icónica Tarjeta en Arco -->
    <div
      class="quince-arch-card relative rounded-t-[140px] sm:rounded-t-[160px] rounded-b-3xl px-4 pt-10 pb-9 sm:px-6 sm:pt-12 sm:pb-10 overflow-hidden text-center text-white"
      style={`background-color: ${archBg}; box-shadow: 0 15px 40px rgba(186, 119, 137, 0.45);`}
    >
      <!-- Silueta SVG de Fondo sutil en Arco -->
      <svg
        viewBox="0 0 400 600"
        fill="currentColor"
        class="w-full h-full absolute inset-0 pointer-events-none opacity-10 text-white"
        preserveAspectRatio="none"
