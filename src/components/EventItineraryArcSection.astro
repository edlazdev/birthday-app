                      </div>
                    </div>

                    <!-- Columna Derecha: Título y Hora -->
                    <div class="w-[calc(50%-14px)] pl-3 text-left">
                      <span
                        class="quince-serif-caps text-xs sm:text-[13px] font-bold tracking-[0.12em] uppercase block leading-tight text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.3)]"
                      >
                        {item.title}
                      </span>
                      {item.time && (
                        <span
                          class="quince-serif-caps text-xs sm:text-[13px] font-bold tracking-wider block text-white/95 mt-0.5 drop-shadow-[0_1px_2px_rgba(0,0,0,0.3)]"
                        >
                          {item.time}
                        </span>
