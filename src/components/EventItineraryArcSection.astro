        <path d="M0,200 C0,89.54 89.54,0 200,0 C310.46,0 400,89.54 400,200 V600 H0 V200 Z"></path>
      </svg>

      <!-- Encabezado Elegante en Arco -->
      <div class="relative z-10 text-center pb-5 select-none">
        {title && (
          <h2
            class="quince-script-title text-4xl sm:text-5xl font-normal leading-tight drop-shadow-[0_2px_4px_rgba(0,0,0,0.18)]"
            style={`color: ${textColor};`}
          >
            {title}
          </h2>
        )}
        {subtitle && (
          <p
            class="quince-script-title text-4xl sm:text-5xl font-normal -mt-1.5 drop-shadow-[0_2px_4px_rgba(0,0,0,0.18)]"
