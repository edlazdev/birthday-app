                            <path d="M28,20 C28,17 32,17 32,20 L32,23 L28,23 Z" fill={archBg} />
                            <path d="M23,22 L37,22 L37,28 L49,34 L49,54 L11,54 L11,34 L23,28 Z" fill="url(#silver-metallic-shine)" stroke="#ffffff" stroke-width="0.8" />
                            <path d="M25,54 L25,42 C25,37 35,37 35,42 L35,54 Z" fill={archBg} stroke="#ffffff" stroke-width="0.6" />
                            <path d="M16,46 L16,40 C16,37 20,37 20,40 L20,46 Z" fill={archBg} />
                            <path d="M40,46 L40,40 C40,37 44,37 44,40 L44,46 Z" fill={archBg} />
                            <circle cx="30" cy="32" r="3.5" fill={archBg} stroke="#ffffff" stroke-width="0.6" />
                            <line x1="8" y1="54" x2="52" y2="54" stroke="url(#silver-metallic-shine)" stroke-width="2" stroke-linecap="round" />
                          </svg>
                        ) : (
                          <span class="text-2xl drop-shadow-md">{item.icon || "✨"}</span>
                        )}
                      </div>
                    </div>
                  </>
                )}
              </div>
            );
          })}
        </div>
      </div>
    </div>
  </div>
)}

