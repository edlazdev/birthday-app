                      {item.description && (
                        <span class="text-[10px] text-white/80 block mt-0.5 leading-tight font-sans">
                          {item.description}
                        </span>
                      )}
                    </div>
                  </>
                ) : (
                  <>
                    <!-- Columna Izquierda: Título y Hora -->
                    <div class="w-[calc(50%-14px)] pr-3 text-right">
                      <span
                        class="quince-serif-caps text-xs sm:text-[13px] font-bold tracking-[0.12em] uppercase block leading-tight text-white drop-shadow-[0_1px_3px_rgba(0,0,0,0.3)]"
