---
import type { EventData } from "@/types";
import { parseEventDateTime, getCountdownValues } from "@/utils/dateParser";
import QuinceSectionImage from "./QuinceSectionImage.astro";
import EventLocationSection from "@/components/EventLocationSection.astro";
import EventDateBanner from "@/components/EventDateBanner.astro";
import EventSponsorsSection from "@/components/EventSponsorsSection.astro";
import EventItineraryArcSection from "@/components/EventItineraryArcSection.astro";
import EventDressCodeSection from "@/components/EventDressCodeSection.astro";
import EventCrestSection from "@/components/EventCrestSection.astro";
import EventMusicPlayer from "@/components/EventMusicPlayer.astro";
import EventCalendarSection from "@/components/EventCalendarSection.astro";
import EventCountdownSection from "@/components/EventCountdownSection.astro";
import EventRibbonDivider from "@/components/EventRibbonDivider.astro";
import EventFarewellSection from "@/components/EventFarewellSection.astro";
import EventGiftSection from "@/components/EventGiftSection.astro";
import EventRsvpModalSection from "@/components/EventRsvpModalSection.astro";

interface Props {
  eventData: EventData;
}

const { eventData } = Astro.props;

// Celebrante y textos sin valores por defecto
const celebrant = eventData.celebrant?.trim() || "";
const tagline = eventData.tagline?.trim() || "";

// Fechas y horas dinámicas (sin fallbacks)
const hasDate = Boolean(eventData.date && eventData.date.trim());
const parsedDate = hasDate ? parseEventDateTime(eventData.date, eventData.time) : null;
const initialCountdown = parsedDate ? getCountdownValues(parsedDate.date.getTime()) : null;

// WhatsApp y RSVP
const hasWhatsapp = Boolean(eventData.whatsapp && eventData.whatsapp.trim());
const whatsappDigits = hasWhatsapp ? eventData.whatsapp.replace(/[^0-9]/g, "") : "";
const showRsvp = eventData.showRsvp !== false && Boolean(whatsappDigits);
const whatsappName = eventData.whatsappName || celebrant;
const rsvpConfig = eventData.rsvpConfig;
const rsvpTitle = rsvpConfig?.title || "Confirmar Asistencia";
const rsvpSubtitle = rsvpConfig?.subtitle || (celebrant ? `Acompáñanos a celebrar los XV Años de ${celebrant}` : "Acompáñanos a celebrar este momento tan especial");
const rsvpButtonText = rsvpConfig?.buttonText || "CONFIRMAR ASISTENCIA";
const rsvpMaxGuests = rsvpConfig?.maxGuests || 5;

// Itinerario: solo si viene explícitamente y con elementos
const hasItinerary = Boolean(
  eventData.showItinerary !== false &&
    Array.isArray(eventData.itinerary) &&
    eventData.itinerary.length > 0,
);
const itineraryItems = hasItinerary ? eventData.itinerary! : [];
const itineraryConfig = eventData.itineraryConfig;
const itineraryTitle = itineraryConfig?.title || "Itinerario";
const itinerarySubtitle = itineraryConfig?.subtitle || "Actividades";

// Código de Vestimenta: soporta eventData.dressCodeConfig y flag showDressCode
const showDressCode = eventData.showDressCode !== false;
const dressCodeConfig = eventData.dressCodeConfig;
const dressCodeTitle = dressCodeConfig?.title ?? "Código de vestimenta";
const dressCodeCategory = dressCodeConfig?.category ?? "FORMAL";
const dressCodeMessage =
  dressCodeConfig?.message ??
  "Con mucho cariño le pedimos evitar el color Plateado, Rosa y Fucsia está reservado para la quinceañera";
const dressCodeShowColors = dressCodeConfig?.showColors !== false;
const dressCodeColors = dressCodeConfig?.reservedColors ?? [
  { name: "Plateado", hex: "#c5cad1" },
  { name: "Rosa", hex: "#f4a6b8" },
  { name: "Fucsia", hex: "#d946ef" },
];

// Despedida / Cierre elegante: soporta eventData.farewellConfig y flag showFarewell
const showFarewell = eventData.showFarewell !== false;
const farewellConfig = eventData.farewellConfig;
const farewellMessage =
  farewellConfig?.message ??
  "TU PRESENCIA HARÁ DE ESA NOCHE ALGO ESPECIAL, ÚNICA E INOLVIDABLE";
const farewellSignature = farewellConfig?.signature ?? "¡Te esperamos!";

// Sugerencia de Regalos / Lluvia de Sobres: soporta eventData.giftConfig y flag showGifts
const showGifts = eventData.showGifts !== false;
const giftConfig = eventData.giftConfig;
const giftTitle = giftConfig?.title ?? "Sugerencia de regalos";
const giftMessage =
  giftConfig?.message ??
  "El mejor detalle es tu presencia, pero si quieres tener un detalle conmigo, haz click aquí.";
const giftButtonText = giftConfig?.buttonText ?? "Lluvia de sobres";
const giftAccountHolder = giftConfig?.accountHolder || (celebrant ? `${celebrant} Martínez` : "");
const giftBank = giftConfig?.bank || "Yape";
const giftPhone = giftConfig?.phone || (hasWhatsapp ? eventData.whatsapp : "");
const giftAccountNumber = giftConfig?.accountNumber ?? "";
const giftQrImageUrl = eventData.qrImageUrl || giftConfig?.qrImageUrl || "";
const giftNote = giftConfig?.note || "¡Muchas gracias por acompañarme en este día tan especial!";

// Ceremonia / Misa: soporta eventData.ceremony explícito o extracción del itinerario
const hasExplicitCeremony = Boolean(
  eventData.ceremony &&
    eventData.ceremony.enabled !== false &&
    (eventData.ceremony.place || eventData.ceremony.address || eventData.ceremony.title)
);

const misaItem = !hasExplicitCeremony && itineraryItems.find(
  (i) =>
    i.title?.toLowerCase().includes("misa") ||
    i.title?.toLowerCase().includes("iglesia") ||
    i.title?.toLowerCase().includes("ceremonia"),
);

const hasMisa =
  eventData.showCeremony !== false &&
  (hasExplicitCeremony || Boolean(misaItem));

let misaTitle = "Misa";
let misaTime = "";
let misaDate = parsedDate ? `${parsedDate.day} ${parsedDate.monthShort?.toUpperCase()}` : "";
let misaPlace = "";
let misaAddress = "";
let misaMapUrl = "";
let showMisaMap = true;

if (hasExplicitCeremony && eventData.ceremony) {
  misaTitle = eventData.ceremony.title || "Misa";
  misaTime = eventData.ceremony.time || "";
  misaDate = eventData.ceremony.date || misaDate;
  misaPlace = eventData.ceremony.place || "";
  misaAddress = eventData.ceremony.address || "";
  misaMapUrl = eventData.ceremony.mapUrl || (misaAddress ? `https://maps.google.com/?q=${encodeURIComponent(misaAddress)}` : "");
  showMisaMap = eventData.ceremony.showMap !== false && Boolean(misaMapUrl);
} else if (misaItem) {
  misaTitle = misaItem.title || "Misa";
  misaTime = misaItem.time || "";
  const misaDescription = misaItem.description || "";
  misaPlace = misaDescription;
  if (misaDescription.includes(" - ")) {
    const parts = misaDescription.split(" - ");
    misaPlace = parts[0].trim();
    misaAddress = parts.slice(1).join(" - ").trim();
  }
  const misaMapQuery = encodeURIComponent(misaDescription || misaPlace);
  misaMapUrl = misaMapQuery ? `https://maps.google.com/?q=${misaMapQuery}` : "";
  showMisaMap = Boolean(misaMapUrl);
}

// Recepción: soporta eventData.reception explícito o eventData.address/time
const hasExplicitReception = Boolean(
  eventData.reception &&
    eventData.reception.enabled !== false &&
    (eventData.reception.place || eventData.reception.address || eventData.reception.time)
);
const hasAddress = Boolean(eventData.address && eventData.address.trim());
const hasTime = Boolean(eventData.time && eventData.time.trim());
const hasReception = hasExplicitReception || hasAddress || hasTime;

let receptionTitle = "Recepción";
let receptionDate = parsedDate ? `${parsedDate.day} ${parsedDate.monthShort?.toUpperCase()}` : "";
let receptionTime = eventData.time || "";
let receptionPlace = eventData.address || "";
let receptionAddress = "";
let receptionMapUrl = "";
let showReceptionMap = true;

if (hasExplicitReception && eventData.reception) {
  receptionTitle = eventData.reception.title || "Recepción";
  receptionDate = eventData.reception.date || receptionDate;
  receptionTime = eventData.reception.time || receptionTime;
  receptionPlace = eventData.reception.place || "";
  receptionAddress = eventData.reception.address || "";
  receptionMapUrl = eventData.reception.mapUrl || "";
  showReceptionMap = eventData.reception.showMap !== false && Boolean(receptionMapUrl);
} else {
  if (eventData.address && eventData.address.includes(" - ")) {
    const parts = eventData.address.split(" - ");
    receptionPlace = parts[0].trim();
    receptionAddress = parts.slice(1).join(" - ").trim();
  }
  const hasMapCoords = Boolean(eventData.map && (eventData.map.lat || eventData.map.lng));
  receptionMapUrl = hasMapCoords
    ? `https://www.google.com/maps/search/?api=1&query=${eventData.map.lat},${eventData.map.lng}`
    : hasAddress
    ? `https://maps.google.com/?q=${encodeURIComponent(eventData.address)}`
    : "";
  showReceptionMap = eventData.showMap !== false && Boolean(receptionMapUrl);
}

// Padrinos y padres (Cortejo): solo si existen
const parentsList = (eventData.sponsors?.groom || []).filter(Boolean);
const godparentsList = (eventData.sponsors?.bride || []).filter(Boolean);
const hasParents = Boolean(eventData.showSponsors !== false && parentsList.length > 0);
const hasGodparents = Boolean(eventData.showSponsors !== false && godparentsList.length > 0);
const hasSponsors = hasParents || hasGodparents;
const sponsorsConfig = eventData.sponsorsConfig;

// Fotos
const slug = eventData.slug || "";
const heroPhoto = eventData.coverUrl || (slug === "luana" ? `/assets/events/${slug}/hero.jpg` : "");
const middlePhoto =
  eventData.middlePhotoUrl ||
  (eventData.albumUrls && eventData.albumUrls.length > 0 ? eventData.albumUrls[0] : "") ||
  (slug === "luana" ? `/assets/events/${slug}/tea.jpg` : "");
const finalPhoto =
  eventData.finalPhotoUrl ||
  (eventData.albumUrls && eventData.albumUrls.length > 1 ? eventData.albumUrls[1] : "") ||
  (slug === "luana" ? `/assets/events/${slug}/cup.jpg` : "");
const ribbonPhoto = (eventData as any).ribbonUrl || `/assets/events/${slug || "luana"}/lazo_plateado.png`;
const crestFramePhoto = (eventData as any).crestUrl || `/assets/events/${slug || "luana"}/marco_flores.jpg`;
const crestAge = eventData.age
  ? (eventData.age.trim() === "15" ? "XV" : eventData.age.trim())
  : "XV";

// ==========================================
// PALETA EXACTA A LA IMAGEN DE REFERENCIA:
// ==========================================
// - Fondo exterior de la página: dusty rose / rosado vintage (#aa596e)
// - Fondo de la tarjeta central: blanco puro (#ffffff)
// - Títulos caligráficos y acentos románticos: dusty rose (#a85d72)
// - Botones de acción ("VER UBICACIÓN", etc.): frambuesa vibrante (#d6336c)
// - Arco de Itinerario: dusty rose suave (#c78596) con texto blanco (#ffffff)
// - Textos principales: gris carbón oscuro (#1f2937)
// - Textos secundarios / direcciones: gris medio (#6b7280)
// - Detalles de lazos / marco: plateado metálico (#9fa6b0 / #c0c5cb)
// - Bordes de tarjetas: rosado suave sutil (#edd6dc)

const pageBg = "#aa596e";
const cardBg = "#ffffff";
const primaryRose = "#a85d72";
const accentPink = "#d6336c";
const archBg = "#c78596";
const textDark = "#1f2937";
const textBody = "#374151";
const textMuted = "#6b7280";
const textSubtle = "#9ca3af";
const silver = "#9fa6b0";
const borderSoft = "#edd6dc";
const playerBg = "#fff8fa";

// ========================================================
// SISTEMA DE TIPOGRAFÍAS DE QUINCEAÑERA:
// 1. Script Cursivo (Títulos y Nombres Caligráficos):
//    - Hero celebrante, Luana sobre escudo, Misa, Recepción,
//      Itinerario, Código de vestimenta, Solo faltan, día '31'.
//    - DEFAULT: 'Great Vibes', 'Alex Brush', 'Pinyon Script', cursive
// 2. Serif Mayúsculas (Títulos Romanos, Monogramas y Badges):
//    - MIS XV AÑOS, XV monograma, QUINCEAÑERA, DALE PLAY,
//      Padres y Padrinos, JULIO 2026, VIERNES, FORMAL, etc.
//    - DEFAULT: 'Cinzel', 'Playfair Display', serif
// 3. Cita / Pensamiento Romántico:
//    - Dedicatoria "{tagline}"
//    - DEFAULT: 'Cormorant Garamond', 'Cinzel', 'Playfair Display', serif
// 4. Sans-serif Moderno (Datos, Fechas y Botones):
//    - Grilla del calendario, contador digital, direcciones y botones.
//    - DEFAULT: 'Montserrat', sans-serif
// ========================================================
const isScriptConfigured = Boolean(
  eventData.fonts?.title?.family &&
    (eventData.fonts.title.family.includes("Vibes") ||
      eventData.fonts.title.family.includes("Script") ||
      eventData.fonts.title.family.includes("Brush") ||
      eventData.fonts.title.family.includes("Pacifico")),
);

const scriptFontFamily = isScriptConfigured && eventData.fonts!.title.family !== "Great Vibes"
  ? `'${eventData.fonts!.title.family}', 'Great Vibes', 'Alex Brush', cursive`
  : `'Great Vibes', 'Alex Brush', 'Pinyon Script', cursive`;

const isSerifConfigured = Boolean(
  eventData.fonts?.title?.family &&
    !isScriptConfigured &&
    eventData.fonts.title.family !== "Playfair Display" &&
    eventData.fonts.title.family !== "Cinzel",
);

const serifFontFamily = isSerifConfigured
  ? `'${eventData.fonts!.title.family}', 'Cinzel', 'Playfair Display', serif`
  : `'Cinzel', 'Playfair Display', serif`;

const quoteFontFamily = `'Cormorant Garamond', 'Cinzel', 'Playfair Display', serif`;

const isCustomSans = Boolean(
  eventData.fonts?.text?.family &&
    eventData.fonts.text.family !== "Montserrat" &&
    eventData.fonts.text.family !== "Poppins" &&
    eventData.fonts.text.family !== "Playfair Display",
);

const sansFontFamily = isCustomSans
  ? `'${eventData.fonts!.text.family}', 'Montserrat', sans-serif`
  : `'Montserrat', sans-serif`;
---

<!-- Importación de Google Fonts para caligrafía de gala, serif imperial y quote -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;600;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400&family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700&family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&family=Poppins:wght@300;400;500;600;700&family=Pacifico&display=swap"
  rel="stylesheet"
/>

{eventData.fonts?.title?.type === "google" && eventData.fonts.title.family && (
  <link
    rel="stylesheet"
    href={`https://fonts.googleapis.com/css2?family=${eventData.fonts.title.family.replace(/\s+/g, "+")}:wght@400;600;700&display=swap`}
  />
)}
{eventData.fonts?.text?.type === "google" && eventData.fonts.text.family && (
  <link
    rel="stylesheet"
    href={`https://fonts.googleapis.com/css2?family=${eventData.fonts.text.family.replace(/\s+/g, "+")}:wght@300;400;500;600;700&display=swap`}
  />
)}

<div
  class="quince-page-wrapper min-h-screen flex justify-center py-0 pt-0 pb-0 px-2 sm:px-4"
  style={`background: linear-gradient(180deg, ${pageBg} 0%, #994c60 100%); color: ${textBody}; --font-quince-script: ${scriptFontFamily}; --font-quince-serif: ${serifFontFamily}; --font-quince-quote: ${quoteFontFamily}; --font-quince-sans: ${sansFontFamily};`}
>
  <!-- Contenedor Plateado en Degradado (sin padding superior/inferior, con padding left/right) -->
  <div
    class="quince-silver-container w-full max-w-[440px] flex flex-col relative py-0 px-3 sm:px-3.5"
    style="background: linear-gradient(90deg, #b0b7bf 0%, #dbe0e6 12%, #f4f6f8 24%, #c5cbd3 50%, #f4f6f8 76%, #dbe0e6 88%, #b0b7bf 100%); box-shadow: 0 25px 60px rgba(70, 15, 30, 0.45), 0 10px 30px rgba(0, 0, 0, 0.3);"
  >
    <!-- Contenedor Tarjeta Central Móvil en Blanco Puro (a ras en la parte superior sin bordes redondeados) -->
    <main
      class="quince-mobile-card w-full flex flex-col relative text-center bg-white shadow-xs"
      style={`background-color: ${cardBg};`}
    >
    <!-- ==========================================
         PANEL 1: HERO & PRESENTACIÓN
    =========================================== -->

    <!-- 1. Hero Photo con Cortinas y Título -->
    <header class="relative w-full overflow-hidden bg-slate-100">
      <div
        class={`hero-image-container relative w-full ${heroPhoto ? "aspect-[2/3]" : "py-16"} overflow-hidden flex flex-col justify-center`}
      >
        {heroPhoto && (
          <img
            src={heroPhoto}
            alt={`Mis XV Años${celebrant ? ` - ${celebrant}` : ""}`}
            class="w-full h-full object-cover object-top"
            loading="eager"
          />
        )}
        <!-- Overlay superior con degradado dinámico hacia la base blanca -->
        <div
          class="absolute inset-0 pointer-events-none"
          style="background: linear-gradient(180deg, rgba(0,0,0,0.5) 0%, rgba(0,0,0,0.15) 25%, transparent 45%, rgba(255,255,255,0.7) 92%, #ffffff 100%);"
        >
        </div>

        <!-- Título Caligráfico Superior en Blanco Elegante con amplio margen -->
        <div class={`${heroPhoto ? "absolute top-3.5 sm:top-4 left-0 right-0" : "relative"} px-4 text-center z-10`}>
          {celebrant && (
            <h1
              class="quince-script-title text-4xl sm:text-5xl text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.75)] leading-none font-normal"
            >
              {celebrant}
            </h1>
          )}
          <p
            class="quince-serif-caps text-[11px] sm:text-xs tracking-[0.3em] uppercase font-semibold mt-1 text-white drop-shadow-[0_2px_6px_rgba(0,0,0,0.85)]"
          >
            {eventData.beforeCelebrant || (eventData.title ? eventData.title.toUpperCase() : "MIS XV AÑOS")}
          </p>
        </div>
      </div>
    </header>

    <!-- 2. Lazo / Moño Divisor Plateado debajo de la imagen -->
    {ribbonPhoto && (
      <div class="quince-ribbon-divider-full relative w-full flex items-center justify-center -mt-8 sm:-mt-10 mb-0 z-10 pointer-events-none select-none">
        <img
          src={ribbonPhoto}
          alt="Lazo plateado"
          class="w-full h-auto object-contain drop-shadow-[0_4px_10px_rgba(0,0,0,0.12)]"
          loading="eager"
        />
      </div>
    )}

    <!-- 3 & 4. Componente Reutilizable: Escudo Monograma, Pensamiento y Badge -->
    <EventCrestSection
      tagline={tagline}
      celebrant={celebrant}
      crestFrameUrl={crestFramePhoto}
      monogramText={crestAge}
      badgeText={eventData.title || "QUINCEAÑERA"}
      primaryColor={primaryRose}
      textColor={textDark}
      textMutedColor={textMuted}
      borderColor={borderSoft}
    />

    <!-- 5. Componente Reutilizable: Reproductor Musical "DALE PLAY" -->
    <EventMusicPlayer
      title="DALE PLAY"
      youtubeUrl={eventData.musicConfig?.youtubeUrl}
      startSecond={eventData.musicConfig?.startSecond}
      songTitle={eventData.musicConfig?.songTitle}
      autoplay={eventData.musicConfig?.autoplay ?? true}
      primaryColor={primaryRose}
      accentColor={accentPink}
      bgColor={playerBg}
      borderColor={borderSoft}
    />

    <EventRibbonDivider color={silver} />

    <section class="px-6 py-1">
      <!-- 6. Sección Reutilizable de Padres y Padrinos de Honor -->
      {hasSponsors && (
        <EventSponsorsSection
          introText={sponsorsConfig?.introText}
          parentsLabel={sponsorsConfig?.parentsLabel}
          parents={parentsList}
          godparentsLabel={sponsorsConfig?.godparentsLabel}
          godparents={godparentsList}
          primaryColor={primaryRose}
          textColor={textDark}
        />
      )}
    </section>

    <!-- ==========================================
         PANEL 2: CALENDARIO & CEREMONIA
    =========================================== -->
    <div class="px-5 py-3 space-y-5">
      <!-- 7 & 8. Banner de Fecha y Tarjeta del Calendario: solo si hay fecha -->
      {hasDate && parsedDate && (
        <>
          <!-- 7. Banner de Fecha Elegante con Doble Línea y Día Caligráfico -->
          <EventDateBanner
            date={eventData.date}
            time={eventData.time}
            month={eventData.dateBanner?.month}
            dayOfWeek={eventData.dateBanner?.dayOfWeek}
            day={eventData.dateBanner?.day}
            year={eventData.dateBanner?.year}
            primaryColor={primaryRose}
            dayColor={silver}
            lineColor={silver}
          />

          <!-- 8. Componente Reutilizable: Calendario Mensual "El Gran Día" -->
          <EventCalendarSection
            title="El gran día"
            monthName={parsedDate.monthName}
            year={parsedDate.year}
            day={parsedDate.day}
            daysInMonth={parsedDate.daysInMonth}
            startOffsetMonday={parsedDate.startOffsetMonday}
            highlightIcon="🤍"
            primaryColor={primaryRose}
            accentColor={accentPink}
            textColor={textBody}
            subtleColor={textSubtle}
          />
        </>
      )}

      <!-- 9. Foto Intermedia de Sesión: componente reutilizable -->
      {middlePhoto && (
        <QuinceSectionImage
          src={middlePhoto}
          alt={`Sesión de fotos${celebrant ? ` de ${celebrant}` : ""}`}
          aspectRatio="square"
        />
      )}

      <!-- Separador de Lazo Plateado antes de Ceremonia: componente reutilizable -->
      <EventRibbonDivider color={silver} />

      <!-- 10. Ceremonia Religiosa (Misa) -->
      {hasMisa && (
        <EventLocationSection
          type="ceremony"
          icon="church"
          iconColor={silver}
          title={misaTitle}
          date={misaDate}
          time={misaTime}
          place={misaPlace}
          address={misaAddress}
          mapUrl={misaMapUrl}
          showMap={showMisaMap}
          primaryColor={primaryRose}
          accentColor={primaryRose}
          textColor={textDark}
          textMutedColor={textMuted}
        />
      )}

      <!-- ==========================================
           PANEL 3: RECEPCIÓN, ITINERARIO & CUENTA REGRESIVA
      =========================================== -->

      <!-- 11. Recepción (Fiesta) -->
      {hasReception && (
        <EventLocationSection
          type="reception"
          icon="reception"
          iconColor={silver}
          title={receptionTitle}
          date={receptionDate}
          time={receptionTime}
          place={receptionPlace}
          address={receptionAddress}
          mapUrl={receptionMapUrl}
          showMap={showReceptionMap}
          primaryColor={primaryRose}
          accentColor={primaryRose}
          textColor={textDark}
          textMutedColor={textMuted}
        />
      )}

      <!-- 12. LA ICÓNICA TARJETA EN ARCO: ITINERARIO DE ACTIVIDADES (Rosa Empolvado #c78596 con Texto Blanco) -->
      {hasItinerary && (
        <>
          <!-- Moño Divisor entre Recepción e Itinerario: componente reutilizable -->
          <EventRibbonDivider color={silver} />

          <!-- 12. Componente Reutilizable: Tarjeta en Arco con Línea de Tiempo Alternada -->
          <EventItineraryArcSection
            itinerary={itineraryItems}
            title={itineraryTitle}
            subtitle={itinerarySubtitle}
            archBg={archBg}
            textColor="#ffffff"
          />

        </>
      )}

      <!-- 13. Componente Reutilizable: Código de Vestimenta (Dress Code) -->
      {showDressCode && (
        <>
          <!-- Moño Divisor Plateado antes de Código de Vestimenta: componente reutilizable -->
          <EventRibbonDivider color={silver} />

          <EventDressCodeSection
            title={dressCodeTitle}
            category={dressCodeCategory}
            message={dressCodeMessage}
            showColors={dressCodeShowColors}
            reservedColors={dressCodeColors}
            primaryColor={primaryRose}
            textColor={textDark}
            textMutedColor={textMuted}
          />
        </>
      )}

      <!-- 14. Componente Reutilizable: Cuenta Regresiva ("Solo faltan") -->
      {hasDate && parsedDate && initialCountdown && (
        <EventCountdownSection
          title="Solo faltan"
          targetIso={parsedDate.targetIso}
          initialDays={initialCountdown.days}
          initialHours={initialCountdown.hours}
          initialMinutes={initialCountdown.minutes}
          initialSeconds={initialCountdown.seconds}
          hasPassed={parsedDate.hasPassed}
          celebrationText="🎉 ¡Llegó el gran día!"
          primaryColor={primaryRose}
          textColor={textDark}
          subtleColor={textSubtle}
          accentColor={accentPink}
        />
      )}

      <!-- 14. Componente Reutilizable: Sugerencia de Regalos / Lluvia de Sobres -->
      {showGifts && (
        <>
          <EventRibbonDivider color={silver} />

          <EventGiftSection
            title={giftTitle}
            message={giftMessage}
            buttonText={giftButtonText}
            accountHolder={giftAccountHolder}
            bank={giftBank}
            phone={giftPhone}
            accountNumber={giftAccountNumber}
            qrImageUrl={giftQrImageUrl}
            note={giftNote}
            primaryColor={primaryRose}
            accentColor={accentPink}
            textColor={textDark}
          />
        </>
      )}

      <!-- 15. Foto Final de Sesión: componente reutilizable -->
      {finalPhoto && (
        <QuinceSectionImage
          src={finalPhoto}
          alt={`Recuerdo${celebrant ? ` de ${celebrant}` : ""}`}
          aspectRatio="portrait"
        />
      )}

      <!-- 15. Componente Reutilizable: Confirmar Asistencia con Modal y WhatsApp -->
      {showRsvp && (
        <EventRsvpModalSection
          whatsapp={whatsappDigits}
          whatsappName={whatsappName}
          celebrant={celebrant}
          eventName={eventData.title || (celebrant ? `Mis XV Años - ${celebrant}` : "Mis XV Años")}
          title={rsvpTitle}
          subtitle={rsvpSubtitle}
          buttonText={rsvpButtonText}
          maxGuests={rsvpMaxGuests}
          slug={slug}
          primaryColor={primaryRose}
          accentColor={accentPink}
          textColor={textDark}
        />
      )}

      <!-- 16. Componente Reutilizable: Mensaje de Despedida y Cierre Elegante -->
      {showFarewell && (
        <EventFarewellSection
          message={farewellMessage}
          signature={farewellSignature}
          primaryColor={primaryRose}
          textColor={textDark}
        />
      )}

      <!-- Footer elegante -->
      <footer
        class="py-4 border-t text-[11px] text-center"
        style={`border-color: ${borderSoft}; color: ${textMuted};`}
      >
        <p
          class="quince-serif-caps tracking-widest font-semibold"
          style={`color: ${primaryRose};`}
        >
          {celebrant ? `${celebrant} · ` : ""}MIS XV AÑOS
        </p>
        <p class="mt-1 text-[10px] opacity-75">
          © {new Date().getFullYear()} · Todos los derechos reservados
        </p>
      </footer>
    </div>
  </main>
  </div>
</div>

