---
import type { EventData } from "@/types";
import { isDarkTheme } from "@/utils/layout";
import { parseEventDateTime, getCountdownValues } from "@/utils/dateParser";

interface Props {
  eventData: EventData;
}

const { eventData } = Astro.props;

// Datos con fallback a Luana
const celebrant = eventData.celebrant || "Luana";
const tagline = eventData.tagline || "Hay momentos inolvidables que se atesoran en el corazón para siempre. Por esa razón, quiero que compartas conmigo este día tan especial.";
const dateText = eventData.date || "Viernes 31 de Julio 2026";
const timeText = eventData.time || "5:00 PM";
const whatsapp = eventData.whatsapp || "51907074109";
const whatsappName = eventData.whatsappName || celebrant;

// Parsear fecha y hora dinámica del evento
const parsedDate = parseEventDateTime(eventData.date, eventData.time);
const initialCountdown = getCountdownValues(parsedDate.date.getTime());

// Itinerario por defecto o personalizado
const itineraryItems = eventData.itinerary && eventData.itinerary.length > 0
  ? eventData.itinerary
  : [
      { time: "5:00 PM", title: "ENTRADA DE LA QUINCEAÑERA", icon: "👑" },
      { time: "5:30 PM", title: "COMIDA", icon: "🍽️" },
      { time: "6:30 PM", title: "PROTOCOLO & VALS", icon: "🏰" },
      { time: "7:30 PM", title: "BAILE", icon: "💃" },
    ];

const misaItem = itineraryItems.find((i) =>
  i.title?.toLowerCase().includes("misa") || i.title?.toLowerCase().includes("iglesia")
);
const misaTime = misaItem?.time || "2:00 P.M.";

// Padrinos y padres
const parents = eventData.sponsors?.groom?.length ? eventData.sponsors.groom.join(" & ") : "Saúl Martínez & Lucy Brambila";
const godparents = eventData.sponsors?.bride?.length ? eventData.sponsors.bride.join(" & ") : "Filiberto Nava & Alicia Martínez";

// Fotos
const slug = eventData.slug || "luana";
const heroPhoto = eventData.coverUrl || `/assets/events/${slug}/hero.jpg`;
const teaPhoto = `/assets/events/${slug}/tea.jpg`;
const cupPhoto = `/assets/events/${slug}/cup.jpg`;

// Colores dinámicos del tema configurado en el evento
const theme = eventData.theme || {};
const primary = theme.primary || "#e79db4";
const bg = theme.bg || "#22242A";
const isDark = isDarkTheme(eventData);

// Superficies y contrastes dinámicos según el fondo seleccionado
const cardBg = isDark
  ? (bg === "#22242A" ? "#1d1f24" : "rgba(255, 255, 255, 0.04)")
  : "rgba(255, 255, 255, 0.95)";
const textBaseColor = isDark ? "#f8fafc" : "#1e293b";
const textMutedColor = isDark ? "#94a3b8" : "#64748b";
const textSubtleColor = isDark ? "#cbd5e1" : "#475569";
const btnTextColor = isDark ? "#22242A" : "#ffffff";

// Mensaje WhatsApp
const whatsappMessage = encodeURIComponent(`¡Hola ${whatsappName}! Confirmo con mucha alegría mi asistencia a los XV Años de ${celebrant} 🎉`);
const whatsappUrl = `https://wa.me/${whatsapp.replace(/[^0-9]/g, '')}?text=${whatsappMessage}`;
---

<!-- Importación de Google Fonts para caligrafía de gala y serif de lujo -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=Alex+Brush&family=Cinzel:wght@400;600;700&family=Great+Vibes&family=Montserrat:wght@300;400;500;600;700&family=Pinyon+Script&family=Playfair+Display:ital,wght@0,400;0,600;0,700;1,400&display=swap"
  rel="stylesheet"
/>

<div
  class="quince-page-wrapper min-h-screen flex justify-center py-4 px-2 sm:px-4 transition-colors"
  style={`background-color: ${bg}; color: ${textBaseColor}; --quince-primary: ${primary}; --quince-bg: ${bg}; --quince-card-bg: ${cardBg};`}
>
  <!-- Contenedor Tarjeta Central Móvil -->
  <main
    class="quince-mobile-card w-full max-w-[440px] rounded-[2.5rem] shadow-[0_20px_50px_rgba(0,0,0,0.8)] overflow-hidden flex flex-col relative text-center border"
    style={`background-color: ${bg}; border-color: ${primary}40; box-shadow: 0 20px 50px rgba(0,0,0,0.7), 0 0 30px ${primary}20;`}
  >

    <!-- ==========================================
         PANEL 1: HERO & PRESENTACIÓN
    =========================================== -->
    
    <!-- 1. Hero Photo con Cortinas y Título -->
    <header class="relative w-full overflow-hidden bg-black/40">
      <div class="hero-image-container relative w-full aspect-[3/4] overflow-hidden">
        <img
          src={heroPhoto}
          alt={`Mis XV Años - ${celebrant}`}
          class="w-full h-full object-cover object-top"
          loading="eager"
        />
        <!-- Overlay superior con degradado dinámico -->
        <div
          class="absolute inset-0 pointer-events-none"
          style={`background: linear-gradient(180deg, ${bg}cc 0%, transparent 40%, ${bg} 100%);`}
        ></div>

        <!-- Título Caligráfico Superior -->
        <div class="absolute top-6 left-0 right-0 px-4 text-center">
          <h1 class="quince-script-title text-4xl sm:text-5xl text-white drop-shadow-[0_2px_8px_rgba(0,0,0,0.8)] leading-none font-normal">
            {celebrant}
          </h1>
          <p
            class="quince-serif-caps text-xs sm:text-sm tracking-[0.3em] uppercase font-semibold mt-1 drop-shadow-[0_1px_4px_rgba(0,0,0,0.8)]"
            style={`color: ${primary};`}
          >
            MIS XV AÑOS
          </p>
        </div>
      </div>
    </header>

    <!-- 2. Lazo / Moño Divisor (Icono 1: Moño) -->
    <div class="quince-ribbon-divider-full relative py-2 flex items-center justify-center">
      <div
        class="ribbon-band h-[2px] w-full absolute top-1/2 -translate-y-1/2"
        style={`background: linear-gradient(90deg, transparent, ${primary}, transparent);`}
      ></div>
      <!-- Moño central ornamental -->
      <div class="relative z-10 px-3" style={`background-color: ${bg}; color: ${primary};`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-12 h-12 drop-shadow-md">
          <!-- Bucles del moño -->
          <path d="M12 12c-3-3-6-5-8-2s-1 6 2 6c3 0 5-2 6-4z" />
          <path d="M12 12c3-3 6-5 8-2s1 6-2 6c-3 0-5-2-6-4z" />
          <!-- Cintas colgantes -->
          <path d="M11 14.5c-1 3-3 6-5 7 1-2 4-4 5-7z" />
          <path d="M13 14.5c1 3 3 6 5 7-1-2-4-4-5-7z" />
          <!-- Nudo central -->
          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </div>
    </div>

    <!-- 3. Pensamiento / Dedicatoria Emotiva -->
    <section class="px-6 py-4">
      <p
        class="quince-quote-text text-[11px] sm:text-xs leading-relaxed uppercase tracking-[0.14em] font-serif"
        style={`color: ${textSubtleColor};`}
      >
        "{tagline}"
      </p>

      <!-- Nombre en caligrafía script grande -->
      <div class="my-4">
        <span
          class="quince-script-title text-4xl sm:text-5xl tracking-wide block"
          style={`color: ${primary};`}
        >
          {celebrant}
        </span>
      </div>

      <!-- 4. Escudo Monograma XV Barroco con Corona (Icono 5: Corona) -->
      <div class="quince-crest-container my-4 flex justify-center">
        <div class="crest-frame relative w-36 h-40 flex items-center justify-center p-2">
          <!-- Marco decorativo barroco SVG -->
          <svg class="absolute inset-0 w-full h-full drop-shadow-md" style={`color: ${primary};`} viewBox="0 0 140 160" fill="none">
            <rect x="15" y="15" width="110" height="130" rx="30" stroke="currentColor" stroke-width="1.5" stroke-dasharray="2 3" opacity="0.5" />
            <path d="M25 40 C25 20, 45 10, 70 10 C95 10, 115 20, 115 40 C115 60, 125 100, 115 125 C105 145, 85 152, 70 152 C55 152, 35 145, 25 125 C15 100, 25 60, 25 40 Z" stroke="currentColor" stroke-width="2" fill={bg} />
            <path d="M50 145 Q60 135 70 145 Q80 135 90 145" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            <circle cx="48" cy="142" r="3" fill="currentColor" />
            <circle cx="70" cy="140" r="3.5" fill="currentColor" />
            <circle cx="92" cy="142" r="3" fill="currentColor" />
          </svg>
          
          <!-- Contenido del escudo con Corona SVG -->
          <div class="relative z-10 flex flex-col items-center">
            <div class="mb-1" style={`color: ${primary};`}>
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-6 h-6">
                <path d="M3 19h18" />
                <path d="M3 15l3-7 3 4 3-7 3 4 3-7 3 7v4H3v-4z" />
                <circle cx="12" cy="3" r="1" />
                <circle cx="6" cy="6" r="1" />
                <circle cx="18" cy="6" r="1" />
              </svg>
            </div>
            <span class="quince-serif-caps text-3xl sm:text-4xl font-bold tracking-widest text-white">
              XV
            </span>
            <span
              class="text-[9px] uppercase tracking-[0.25em] font-semibold mt-0.5"
              style={`color: ${primary};`}
            >
              Años
            </span>
          </div>
        </div>
      </div>

      <!-- Badge "QUINCEAÑERA" -->
      <div class="mt-2 mb-4">
        <span
          class="quince-serif-caps text-xs tracking-[0.3em] uppercase font-bold border-y py-1.5 px-6 inline-block"
          style={`color: ${primary}; border-color: ${primary}50;`}
        >
          QUINCEAÑERA
        </span>
      </div>

      <!-- 5. Reproductor "DALE PLAY" con lazos a los costados -->
      <div
        class="quince-player-box my-4 p-3.5 rounded-2xl relative overflow-hidden max-w-[280px] mx-auto shadow-inner border"
        style={`background-color: ${cardBg}; border-color: ${primary}35;`}
      >
        <!-- Rizo / Lazo lateral izquierdo -->
        <span class="absolute left-1.5 top-1/2 -translate-y-1/2 text-xs opacity-60" style={`color: ${primary};`}>〰️</span>
        <!-- Rizo / Lazo lateral derecho -->
        <span class="absolute right-1.5 top-1/2 -translate-y-1/2 text-xs opacity-60" style={`color: ${primary};`}>〰️</span>

        <span
          class="quince-serif-caps text-[10px] tracking-[0.25em] font-bold block mb-2"
          style={`color: ${primary};`}
        >
          DALE PLAY
        </span>
        <div class="flex items-center justify-center gap-5 text-sm" style={`color: ${textSubtleColor};`}>
          <button type="button" class="hover:scale-110 transition cursor-pointer" aria-label="Anterior">⏮</button>
          <button
            type="button"
            class="w-8 h-8 rounded-full flex items-center justify-center font-bold text-xs shadow-md hover:scale-105 transition cursor-pointer"
            style={`background-color: ${primary}; color: ${btnTextColor}; box-shadow: 0 2px 8px ${primary}60;`}
            aria-label="Reproducir música"
          >
            ▶
          </button>
          <button type="button" class="hover:scale-110 transition cursor-pointer" aria-label="Siguiente">⏭</button>
        </div>
        <!-- Barra de progreso con nodo -->
        <div class="w-full bg-black/25 h-1 rounded-full mt-2.5 relative flex items-center">
          <div class="h-full w-2/5 rounded-full" style={`background-color: ${primary};`}></div>
          <div
            class="w-2.5 h-2.5 rounded-full shadow -ml-1 border"
            style={`background-color: #ffffff; border-color: ${primary};`}
          ></div>
        </div>
      </div>

      <!-- Moño Divisor Pequeño (Icono 1: Moño) -->
      <div class="my-3 flex justify-center" style={`color: ${primary};`}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 drop-shadow-sm">
          <path d="M12 12c-3-3-6-5-8-2s-1 6 2 6c3 0 5-2 6-4z" />
          <path d="M12 12c3-3 6-5 8-2s1 6-2 6c-3 0-5-2-6-4z" />
          <path d="M11 14.5c-1 3-3 6-5 7 1-2 4-4 5-7z" />
          <path d="M13 14.5c1 3 3 6 5 7-1-2-4-4-5-7z" />
          <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
        </svg>
      </div>

      <!-- 6. Padres y Padrinos (Cortejo) -->
      <div
        class="quince-court-card p-4 rounded-2xl border space-y-2 text-center text-xs"
        style={`background-color: ${cardBg}; border-color: ${primary}30;`}
      >
        <p
          class="quince-serif-caps text-[10px] sm:text-[11px] tracking-[0.2em] uppercase font-semibold leading-relaxed"
          style={`color: ${textSubtleColor};`}
        >
          ACOMPÁÑAME EN ESTE DÍA TAN ESPECIAL JUNTO A
        </p>

        <div class="py-1">
          <span class="text-[9px] uppercase tracking-[0.18em] block font-semibold" style={`color: ${primary};`}>
            MIS PADRES:
          </span>
          <p class="quince-serif-caps text-xs sm:text-sm font-bold text-white tracking-wider mt-0.5">
            {parents}
          </p>
        </div>

        <div class="py-1">
          <span class="text-[9px] uppercase tracking-[0.18em] block font-semibold" style={`color: ${primary};`}>
            MIS PADRINOS:
          </span>
          <p class="quince-serif-caps text-xs sm:text-sm font-bold text-white tracking-wider mt-0.5">
            {godparents}
          </p>
        </div>

        <p class="quince-serif-caps text-[10px] tracking-[0.25em] uppercase font-bold pt-1" style={`color: ${primary};`}>
          A FESTEJAR MIS XV AÑOS
        </p>
      </div>
    </section>

    <!-- ==========================================
         PANEL 2: CALENDARIO & CEREMONIA (MISA)
    =========================================== -->
    <div class="px-5 py-3 space-y-5">
      <!-- 7. Banner de Fecha Dinámica -->
      <div
        class="quince-date-badge py-3 px-4 rounded-2xl border"
        style={`background-color: ${cardBg}; border-color: ${primary}30;`}
      >
        <span class="text-[11px] uppercase tracking-[0.3em] font-semibold block" style={`color: ${primary};`}>
          {parsedDate.monthName}
        </span>
        <div class="flex items-center justify-center gap-3 my-1">
          <span class="quince-serif-caps text-xs uppercase tracking-widest" style={`color: ${textSubtleColor};`}>
            {parsedDate.dayOfWeekName}
          </span>
          <span class="quince-script-title text-4xl text-white -mt-1 font-bold">
            {parsedDate.day}
          </span>
          <span class="quince-serif-caps text-xs uppercase tracking-widest" style={`color: ${textSubtleColor};`}>
            {parsedDate.year}
          </span>
        </div>
      </div>

      <!-- 8. Tarjeta del Calendario Dinámica -->
      <div
        class="quince-calendar-card p-4 rounded-2xl border relative"
        style={`background-color: ${cardBg}; border-color: ${primary}30;`}
      >
        <span class="quince-script-title text-2xl sm:text-3xl block" style={`color: ${primary};`}>
          El gran día
        </span>
        <span class="quince-serif-caps text-xs tracking-[0.25em] uppercase text-white font-semibold">
          {parsedDate.monthName} {parsedDate.year}
        </span>

        <!-- Grilla del mes -->
        <div class="grid grid-cols-7 gap-1 text-[9px] font-semibold mt-3 mb-1" style={`color: ${textMutedColor};`}>
          <span>LUN</span><span>MAR</span><span>MIÉ</span><span>JUE</span><span>VIE</span><span>SÁB</span><span>DOM</span>
        </div>
        <div class="grid grid-cols-7 gap-1 text-[11px] font-medium" style={`color: ${textSubtleColor};`}>
          {Array.from({ length: parsedDate.startOffsetMonday }).map(() => (
            <div></div>
          ))}
          {Array.from({ length: parsedDate.daysInMonth }, (_, i) => i + 1).map((d) => (
            <div class="h-6 flex items-center justify-center relative">
              {d === parsedDate.day ? (
                <div
                  class="w-6 h-6 rounded-full font-black text-[11px] flex items-center justify-center shadow-md scale-110"
                  style={`background-color: ${primary}; color: ${btnTextColor};`}
                >
                  {d}
                  <span class="absolute -top-1 -right-1 text-[8px]">🤍</span>
                </div>
              ) : (
                <span>{d}</span>
              )}
            </div>
          ))}
        </div>
      </div>

      <!-- 9. Foto Intermedia de Sesión (Garden Tea) -->
      <div
        class="quince-portrait-box rounded-2xl overflow-hidden shadow-lg aspect-square border"
        style={`border-color: ${primary}40;`}
      >
        <img
          src={teaPhoto}
          alt={`Sesión de fotos de ${celebrant}`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- 10. Ceremonia Religiosa (Misa) con Icono 3: Iglesia e Icono 6: Ubicación -->
      <div
        class="quince-event-card p-5 rounded-2xl border space-y-2"
        style={`background-color: ${cardBg}; border-color: ${primary}30;`}
      >
        <!-- Icono 3: Iglesia SVG -->
        <div class="w-9 h-9 mx-auto mb-1 flex items-center justify-center" style={`color: ${primary};`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
            <path d="M12 3v5m-2-3h4" /> <!-- Cruz -->
            <path d="M6 11l6-5 6 5v10H6z" /> <!-- Techo y paredes -->
            <path d="M10 21v-4a2 2 0 0 1 4 0v4" /> <!-- Puerta -->
          </svg>
        </div>
        <h3 class="quince-script-title text-3xl leading-none" style={`color: ${primary};`}>
          Misa
        </h3>
        <p class="quince-serif-caps text-xs tracking-wider font-semibold" style={`color: ${textSubtleColor};`}>
          {parsedDate.day} {parsedDate.monthShort} &nbsp;|&nbsp; {misaTime}
        </p>
        <p class="quince-serif-caps text-sm font-bold text-white tracking-widest pt-1">
          SAGRADO CORAZÓN
        </p>
        <p class="text-[11px] leading-snug max-w-[260px] mx-auto" style={`color: ${textMutedColor};`}>
          2800 McGavock Pk Entrance #8, Nashville, TN 37214
        </p>
        <div class="pt-2">
          <a
            href="https://maps.google.com/?q=2800+McGavock+Pk+Entrance+8+Nashville+TN+37214"
            target="_blank"
            rel="noopener noreferrer"
            class="quince-btn-pill inline-flex items-center justify-center px-5 py-2 rounded-full text-xs font-bold tracking-wider uppercase transition shadow-md hover:scale-105 active:scale-95"
            style={`background-color: ${primary}; color: ${btnTextColor}; box-shadow: 0 4px 12px ${primary}40;`}
          >
            <!-- Icono 6: Ubicación SVG -->
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1.5 shrink-0">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
            <span>VER UBICACIÓN</span>
          </a>
        </div>
      </div>

      <!-- ==========================================
           PANEL 3: RECEPCIÓN, ITINERARIO & CUENTA REGRESIVA
      =========================================== -->

      <!-- 11. Recepción (Fiesta) con Icono 4: Copas e Icono 6: Ubicación -->
      <div
        class="quince-event-card p-5 rounded-2xl border space-y-2"
        style={`background-color: ${cardBg}; border-color: ${primary}30;`}
      >
        <!-- Icono 4: Copas SVG -->
        <div class="w-9 h-9 mx-auto mb-1 flex items-center justify-center" style={`color: ${primary};`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8">
            <path d="M8 22h8" /> <!-- Base -->
            <path d="M12 15v7" /> <!-- Tallo -->
            <path d="M7 4.5l1.5 5.5c.5 2 2.5 5 3.5 5s3-3 3.5-5L17 4.5" /> <!-- Copa -->
            <path d="M8 3v-1M16 3v-1M11 2.5v-1M13 2.5v-1" /> <!-- Burbujas opcionales -->
          </svg>
        </div>
        <h3 class="quince-script-title text-3xl leading-none" style={`color: ${primary};`}>
          Recepción
        </h3>
        <p class="quince-serif-caps text-xs tracking-wider font-semibold" style={`color: ${textSubtleColor};`}>
          {parsedDate.day} {parsedDate.monthShort} &nbsp;|&nbsp; {timeText}
        </p>
        <p class="quince-serif-caps text-sm font-bold text-white tracking-widest pt-1">
          PREMIER CENTER
        </p>
        <p class="text-[11px] leading-snug max-w-[260px] mx-auto" style={`color: ${textMutedColor};`}>
          90 Volunteer Dr Suite 450, Hendersonville, TN 37075
        </p>
        <div class="pt-2">
          <a
            href="https://maps.google.com/?q=90+Volunteer+Dr+Suite+450+Hendersonville+TN+37075"
            target="_blank"
            rel="noopener noreferrer"
            class="quince-btn-pill inline-flex items-center justify-center px-5 py-2 rounded-full text-xs font-bold tracking-wider uppercase transition shadow-md hover:scale-105 active:scale-95"
            style={`background-color: ${primary}; color: ${btnTextColor}; box-shadow: 0 4px 12px ${primary}40;`}
          >
            <!-- Icono 6: Ubicación SVG -->
            <svg viewBox="0 0 24 24" fill="currentColor" class="w-4 h-4 mr-1.5 shrink-0">
              <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5c-1.38 0-2.5-1.12-2.5-2.5s1.12-2.5 2.5-2.5 2.5 1.12 2.5 2.5-1.12 2.5-2.5 2.5z" />
            </svg>
            <span>VER UBICACIÓN</span>
          </a>
        </div>
      </div>

      <!-- Moño Divisor entre Recepción e Itinerario (Icono 1: Moño) -->
      <div class="quince-ribbon-divider relative py-2 flex items-center justify-center my-1">
        <div
          class="h-[1.5px] w-full absolute top-1/2 -translate-y-1/2"
          style={`background: linear-gradient(90deg, transparent, ${primary}, transparent);`}
        ></div>
        <div class="relative z-10 px-3" style={`background-color: ${bg}; color: ${primary};`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 drop-shadow-sm">
            <path d="M12 12c-3-3-6-5-8-2s-1 6 2 6c3 0 5-2 6-4z" />
            <path d="M12 12c3-3 6-5 8-2s1 6-2 6c-3 0-5-2-6-4z" />
            <path d="M11 14.5c-1 3-3 6-5 7 1-2 4-4 5-7z" />
            <path d="M13 14.5c1 3 3 6 5 7-1-2-4-4-5-7z" />
            <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
          </svg>
        </div>
      </div>

      <!-- 12. LA ICÓNICA TARJETA EN ARCO: ITINERARIO DE ACTIVIDADES (Icono 2: Arco) -->
      <div class="quince-arch-container pt-2">
        <!-- El Contenedor con Arco Superior -->
        <div
          class="quince-arch-card relative rounded-t-[140px] sm:rounded-t-[160px] rounded-b-3xl p-6 sm:p-7 overflow-hidden text-center shadow-xl"
          style={`background-color: ${primary}; color: ${btnTextColor}; box-shadow: 0 12px 30px ${primary}40;`}
        >
          <!-- Icono 2: Arco SVG decorativo integrado de fondo -->
          <svg
            viewBox="0 0 400 600"
            fill="currentColor"
            class="w-full h-full absolute inset-0 pointer-events-none opacity-20"
            preserveAspectRatio="none"
            style={`color: ${isDark ? '#ffffff' : '#000000'};`}
          >
            <path d="M0,200 C0,89.54 89.54,0 200,0 C310.46,0 400,89.54 400,200 V600 H0 V200 Z" />
          </svg>
          
          <!-- Encabezado en Arco -->
          <div class="relative z-10 pt-4 pb-4 text-center">
            <h2 class="quince-script-title text-3xl sm:text-4xl text-white font-normal drop-shadow-[0_2px_4px_rgba(0,0,0,0.2)]">
              Itinerario
            </h2>
            <p class="quince-script-title text-2xl sm:text-3xl text-white -mt-2 drop-shadow-[0_2px_4px_rgba(0,0,0,0.2)]">
              de Actividades
            </p>
            <div class="w-12 h-0.5 bg-white/40 mx-auto mt-2"></div>
          </div>

          <!-- Lista de Hitos con Iconos vectoriales -->
          <div class="relative z-10 space-y-4 text-left max-w-[280px] mx-auto pt-1">
            {itineraryItems.map((item) => (
              <div class="flex items-center gap-3.5 border-b border-black/10 pb-2.5 last:border-0">
                <span class="w-9 h-9 rounded-full bg-white/25 flex items-center justify-center shrink-0 text-white shadow-sm">
                  {/* Icono 5: Corona si corresponde a la quinceañera / entrada */}
                  {item.icon === "👑" || item.title.toLowerCase().includes("quinceañera") || item.title.toLowerCase().includes("entrada") ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                      <path d="M3 19h18" />
                      <path d="M3 15l3-7 3 4 3-7 3 4 3-7 3 7v4H3v-4z" />
                      <circle cx="12" cy="3" r="1" />
                      <circle cx="6" cy="6" r="1" />
                      <circle cx="18" cy="6" r="1" />
                    </svg>
                  ) : item.icon === "⛪" || item.title.toLowerCase().includes("misa") || item.title.toLowerCase().includes("iglesia") ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                      <path d="M12 3v5m-2-3h4" />
                      <path d="M6 11l6-5 6 5v10H6z" />
                      <path d="M10 21v-4a2 2 0 0 1 4 0v4" />
                    </svg>
                  ) : item.icon === "🥂" || item.title.toLowerCase().includes("recepción") || item.title.toLowerCase().includes("brindis") ? (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round" class="w-5 h-5">
                      <path d="M8 22h8" />
                      <path d="M12 15v7" />
                      <path d="M7 4.5l1.5 5.5c.5 2 2.5 5 3.5 5s3-3 3.5-5L17 4.5" />
                    </svg>
                  ) : (
                    <span class="text-base">{item.icon || "✨"}</span>
                  )}
                </span>
                <div class="flex-1 min-w-0">
                  <span class="quince-serif-caps text-xs font-bold tracking-wider block text-white drop-shadow-sm leading-tight">
                    {item.title}
                  </span>
                  <span class="text-xs font-bold block mt-0.5" style={`color: ${btnTextColor};`}>
                    {item.time}
                  </span>
                  {item.description && (
                    <span class="text-[10px] text-white/80 block leading-tight mt-0.5">
                      {item.description}
                    </span>
                  )}
                </div>
              </div>
            ))}
          </div>

        </div>

        <!-- Moño decorativo al pie del arco (Icono 1: Moño) -->
        <div class="my-3 flex justify-center" style={`color: ${primary};`}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" class="w-8 h-8 drop-shadow-sm">
            <path d="M12 12c-3-3-6-5-8-2s-1 6 2 6c3 0 5-2 6-4z" />
            <path d="M12 12c3-3 6-5 8-2s1 6-2 6c-3 0-5-2-6-4z" />
            <path d="M11 14.5c-1 3-3 6-5 7 1-2 4-4 5-7z" />
            <path d="M13 14.5c1 3 3 6 5 7-1-2-4-4-5-7z" />
            <circle cx="12" cy="12" r="1.5" fill="currentColor" stroke="none" />
          </svg>
        </div>
      </div>

      <!-- 13. Cuenta Regresiva: "Solo faltan" -->
      <div
        class="quince-countdown-section py-4 px-3 rounded-2xl border text-center"
        style={`background-color: ${cardBg}; border-color: ${primary}30;`}
      >
        <span class="quince-script-title text-3xl sm:text-4xl block mb-1" style={`color: ${primary};`}>
          Solo faltan
        </span>

        <div
          class="countdown-display flex items-center justify-center gap-2 sm:gap-3 text-white my-3"
          id="quince-live-countdown"
          data-target={parsedDate.targetIso}
        >
          <div class="timer-box flex flex-col items-center">
            <span class="text-2xl sm:text-3xl font-extrabold" id="q-days">{initialCountdown.days}</span>
            <span class="text-[9px] uppercase tracking-wider mt-0.5" style={`color: ${textMutedColor};`}>Días</span>
          </div>
          <span class="text-xl font-bold -mt-4" style={`color: ${primary};`}>:</span>
          <div class="timer-box flex flex-col items-center">
            <span class="text-2xl sm:text-3xl font-extrabold" id="q-hours">{initialCountdown.hours}</span>
            <span class="text-[9px] uppercase tracking-wider mt-0.5" style={`color: ${textMutedColor};`}>Horas</span>
          </div>
          <span class="text-xl font-bold -mt-4" style={`color: ${primary};`}>:</span>
          <div class="timer-box flex flex-col items-center">
            <span class="text-2xl sm:text-3xl font-extrabold" id="q-minutes">{initialCountdown.minutes}</span>
            <span class="text-[9px] uppercase tracking-wider mt-0.5" style={`color: ${textMutedColor};`}>Minutos</span>
          </div>
          <span class="text-xl font-bold -mt-4" style={`color: ${primary};`}>:</span>
          <div class="timer-box flex flex-col items-center">
            <span class="text-2xl sm:text-3xl font-extrabold" id="q-seconds">{initialCountdown.seconds}</span>
            <span class="text-[9px] uppercase tracking-wider mt-0.5" style={`color: ${textMutedColor};`}>Segundos</span>
          </div>
        </div>

        <div
          id="q-celebration"
          class={`text-xs font-bold tracking-wide mt-2 py-1 px-3 rounded-full inline-block ${parsedDate.hasPassed ? "" : "hidden"}`}
          style={`background-color: ${primary}25; color: ${primary};`}
        >
          🎉 ¡Llegó el gran día!
        </div>
      </div>

      <!-- 14. Foto Final de Sesión (Holding Teacup) -->
      <div
        class="quince-portrait-box rounded-2xl overflow-hidden shadow-lg aspect-[3/4] border"
        style={`border-color: ${primary}40;`}
      >
        <img
          src={cupPhoto}
          alt={`Recuerdo de ${celebrant}`}
          class="w-full h-full object-cover"
          loading="lazy"
        />
      </div>

      <!-- 15. Botón de RSVP WhatsApp -->
      <div class="py-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="w-full py-3.5 px-6 rounded-full text-sm font-extrabold tracking-wider uppercase flex items-center justify-center gap-2 hover:scale-[1.02] active:scale-95 transition shadow-lg"
          style={`background-color: ${primary}; color: ${btnTextColor}; box-shadow: 0 6px 20px ${primary}50;`}
        >
          <span>✉️</span>
          <span>CONFIRMAR ASISTENCIA</span>
        </a>
      </div>

      <!-- Footer elegante -->
      <footer class="py-4 border-t text-[11px] text-center" style={`border-color: ${primary}25; color: ${textMutedColor};`}>
        <p class="quince-serif-caps tracking-widest" style={`color: ${primary};`}>
          {celebrant} · MIS XV AÑOS
        </p>
        <p class="mt-1 text-[10px] opacity-75">
          © {new Date().getFullYear()} · Todos los derechos reservados
        </p>
      </footer>

    </div>
  </main>
</div>

<!-- Script reactivo para el contador de tiempo -->
<script is:inline>
  (function initLiveCountdown() {
    const el = document.getElementById("quince-live-countdown");
    if (!el) return;
    const targetIso = el.getAttribute("data-target");
    if (!targetIso) return;

    const targetTime = new Date(targetIso).getTime();
    if (isNaN(targetTime)) return;

    const dEl = document.getElementById("q-days");
    const hEl = document.getElementById("q-hours");
    const mEl = document.getElementById("q-minutes");
    const sEl = document.getElementById("q-seconds");
    const celebrationEl = document.getElementById("q-celebration");

    function update() {
      const now = Date.now();
      const diff = Math.max(0, targetTime - now);
      const days = Math.floor(diff / (1000 * 60 * 60 * 24));
      const hours = Math.floor((diff / (1000 * 60 * 60)) % 24);
      const minutes = Math.floor((diff / (1000 * 60)) % 60);
      const seconds = Math.floor((diff / 1000) % 60);

      if (dEl) dEl.textContent = String(days).padStart(2, "0");
      if (hEl) hEl.textContent = String(hours).padStart(2, "0");
      if (mEl) mEl.textContent = String(minutes).padStart(2, "0");
      if (sEl) sEl.textContent = String(seconds).padStart(2, "0");

      if (diff === 0 && celebrationEl) {
        celebrationEl.classList.remove("hidden");
      }
    }

    update();
    setInterval(update, 1000);
  })();
</script>

