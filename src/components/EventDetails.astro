---
import DateTimeCard from "./DateTimeCard.astro";
import MapEmbed from "@/components/MapEmbed.astro";
import type { EventDetailsProps } from "@/types";
import RSVPSection from "./RSVPSection.astro";

type Props = EventDetailsProps;
const { eventData } = Astro.props;
const base = import.meta.env.BASE_URL || "";
const basePath = base.endsWith("/") ? base : `${base}/`;
const albumHref = `${basePath}${eventData.slug}/album`;
---

<section class="details text-center my-4 bg-white shadow-lg rounded-2xl">
  <p class="tagline animate-fade-up animate-delay-1 text-lg md:text-2xl font-black tracking-wider text-[var(--tertiary)] m-0 p-4">{eventData.tagline}</p>
  <div class="event-info text-base md:text-2xl font-normal tracking-wider m-0 px-4 md:px-16 pt-0 md:pt-4 text-[var(--secondary)]">
    <div class="animate-fade-up animate-delay-2">
      <DateTimeCard date={eventData.date} time={eventData.time} />
    </div>
    <RSVPSection whatsapp={eventData.whatsapp} celebrant={eventData.celebrant} whatsappName={eventData.whatsappName} msgTooltip={eventData.msgTooltip} />
    <span class="animate-fade-up animate-delay-3 text-base md:text-xl font-normal tracking-wider py-2 m-0 text-gray-600">Te esperamos en:</span>
    <p class="animate-fade-up animate-delay-4">📍 {eventData.address}</p>
  </div>
  <div class="animate-fade-up animate-delay-5">
    <MapEmbed
      lat={eventData.map.lat}
      lng={eventData.map.lng}
      address={eventData.address}
      provider="openstreetmap"
    />
  </div>

  {eventData.showAlbum !== false && eventData.msgRedirectAlbum && (
    <p class="animate-fade-up animate-delay-6 text-base md:text-xl font-normal m-0 py-4">
      📷
      <a href={albumHref} class="album-link text-gray-600 underline transition-colors duration-200 hover:text-[var(--secondary)]">
        {eventData.msgRedirectAlbum}
      </a>
    </p>
  )}
</section>
<style>
  .details .tagline {
    font-family: var(--font-text, sans-serif);
  }
  .details .event-info {
    font-family: var(--font-text, sans-serif);
  }
  .details .event-info span {
    font-family: var(--font-text, sans-serif);
  }
  .album-link {
    font-family: var(--font-text, sans-serif);
  }
</style>
