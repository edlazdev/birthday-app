---
import RSVPSectionWrapper from "./RSVPSectionWrapper.tsx";
import type { RSVPSectionProps } from "@/types";

type Props = RSVPSectionProps;

const { whatsapp, celebrant, whatsappName, msgTooltip, type } = Astro.props;
---

<RSVPSectionWrapper client:load whatsapp={whatsapp} celebrant={celebrant} whatsappName={whatsappName} msgTooltip={msgTooltip} type={type} />

