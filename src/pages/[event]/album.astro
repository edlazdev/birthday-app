---
import EventLayout from "@/layouts/EventLayout.astro";
import { DEFAULT_EVENT } from "@/utils";  
import EventNav from "@/components/EventNav.astro";
import { getEventImagePath } from "@/utils/images";
import ImageGallery from "@/components/ImageGallery.tsx";
import { getTenantBySlug } from "@/services/tenants";

const { event } = Astro.params;
const eventKey = event ? event : DEFAULT_EVENT;
const data = await getTenantBySlug(eventKey);

if (!data) {
  return Astro.redirect("/");
}

// Si el evento tiene el álbum deshabilitado, redirigir a la invitación
if (data.showAlbum === false) {
  return Astro.redirect(`/${data.slug}`);
}

const albumImages = data.albumUrls && data.albumUrls.length > 0
  ? data.albumUrls
  : Array.from({ length: data.albumCount || 0 }).map((_, i) => 
      getEventImagePath(data.slug, `album/photo (${i}).jpeg`)
    );
---

<EventLayout eventData={data}>
  <main class="event-container">
    <EventNav slug={data.slug} showAlbum={data.showAlbum} />
    
    <ImageGallery client:load images={albumImages} altPrefix="Mes" />
  </main>
</EventLayout>
