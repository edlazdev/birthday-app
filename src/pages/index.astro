---
import "@/styles/global.css";
import { getPublishedTenants } from "@/services/tenants";

Astro.response.headers.set("Cache-Control", "no-store, no-cache, must-revalidate, max-age=0");
Astro.response.headers.set("Pragma", "no-cache");
Astro.response.headers.set("Expires", "0");

const publishedTenants = await getPublishedTenants();
---

<!doctype html>
<html lang="es" class="scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Freeloader | Invitaciones Digitales para Eventos</title>
    <meta
      name="description"
      content="Crea invitaciones digitales interactivas, cálidas y memorables para cumpleaños, bodas, fiestas y baby showers. Música ambiente, confirmación RSVP, mapas y fotos por un único costo de S/ 50."
    />
    <link rel="canonical" href="https://freeloader.artizaro.com" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://freeloader.artizaro.com" />
    <meta property="og:title" content="Freeloader | Invitaciones Digitales para Eventos" />
    <meta
      property="og:description"
      content="Invitaciones interactivas con música, confirmación RSVP, mapas y fotos. Un solo costo por evento."
    />

    <!-- Google Fonts: Poppins -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    <script is:inline>
      // Sincronizar tema antes del primer renderizado para evitar parpadeo
      const savedTheme = localStorage.getItem('freeloader-theme');
      if (savedTheme === 'dark') {
        document.documentElement.classList.add('dark');
      } else {
        document.documentElement.classList.remove('dark');
      }
    </script>

    <style>
      /* Animaciones sutiles para elementos que flotan y llaman la atención de forma amigable */
      @keyframes floatSlow {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(-8px); }
      }
      @keyframes floatReverse {
        0%, 100% { transform: translateY(0px); }
        50% { transform: translateY(8px); }
      }
      @keyframes pulseGlow {
        0%, 100% { opacity: 0.8; transform: scale(1); }
        50% { opacity: 1; transform: scale(1.04); }
      }
      .animate-float-slow {
        animation: floatSlow 4s ease-in-out infinite;
      }
      .animate-float-reverse {
        animation: floatReverse 4.5s ease-in-out infinite;
      }
      .animate-pulse-glow {
        animation: pulseGlow 2.5s ease-in-out infinite;
      }
      .eq-bar {
        display: inline-block;
        width: 3px;
        background-color: currentColor;
        border-radius: 9999px;
        animation: eqPulse 1s ease-in-out infinite alternate;
      }
      @keyframes eqPulse {
        0% { height: 4px; }
        100% { height: 16px; }
      }
      .eq-bar:nth-child(2) { animation-delay: 0.2s; }
      .eq-bar:nth-child(3) { animation-delay: 0.4s; }
      .eq-bar:nth-child(4) { animation-delay: 0.1s; }
    </style>
  </head>
  <body class="bg-[#FAF7F2] dark:bg-slate-950 text-slate-800 dark:text-slate-100 font-sans antialiased transition-colors duration-300 selection:bg-amber-500 selection:text-white relative">
    
    <!-- Canvas para efecto Confeti amigable en pantalla completa -->
    <canvas id="confetti-canvas" class="fixed inset-0 pointer-events-none z-50"></canvas>

    <!-- Fondos decorativos cálidos, luminosos y amigables -->
    <div class="fixed inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[750px] h-[600px] bg-gradient-to-b from-amber-300/25 via-orange-200/20 to-transparent dark:from-amber-500/[0.05] dark:via-transparent rounded-full blur-[140px]"></div>
      <div class="absolute top-1/3 -right-32 w-[550px] h-[550px] bg-rose-300/20 dark:bg-slate-800/[0.12] rounded-full blur-[140px]"></div>
      <div class="absolute -bottom-20 -left-40 w-[600px] h-[600px] bg-amber-200/25 dark:bg-transparent rounded-full blur-[140px]"></div>
    </div>

    <!-- =========================================================================
         1. NAVBAR AMIGABLE & ACCESIBLE
    ========================================================================== -->
    <header class="sticky top-0 z-40 bg-[#FAF7F2]/90 dark:bg-slate-950/80 backdrop-blur-md border-b border-amber-900/[0.06] dark:border-slate-900 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Logo con toque festivo -->
        <a href="/" class="flex items-center gap-2.5 group" id="nav-brand-logo">
          <div class="w-9 h-9 rounded-xl bg-gradient-to-tr from-amber-500 to-amber-600 flex items-center justify-center font-bold text-slate-950 text-xs shadow-md shadow-amber-500/25 group-hover:scale-105 transition transform">
            🎉
          </div>
          <div class="flex items-baseline gap-1.5">
            <span class="text-base font-extrabold text-slate-900 dark:text-white tracking-tight">
              Freeloader
            </span>
            <span class="text-[10px] text-amber-700/80 dark:text-amber-400 font-semibold hidden sm:inline bg-amber-100/60 dark:bg-amber-950/40 px-2 py-0.5 rounded-full">
              Invitaciones
            </span>
          </div>
        </a>

        <!-- Enlaces de navegación -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-medium text-slate-600 dark:text-slate-400">
          <a href="#caracteristicas" class="hover:text-amber-600 dark:hover:text-slate-200 transition" id="nav-link-features">Características</a>
          <a href="#invitaciones" class="hover:text-amber-600 dark:hover:text-slate-200 transition" id="nav-link-invitaciones">Eventos Reales</a>
          <a href="#costo" class="hover:text-amber-600 dark:hover:text-slate-200 transition" id="nav-link-costo">Costo Único</a>
          <a href="#faq" class="hover:text-amber-600 dark:hover:text-slate-200 transition" id="nav-link-faq">Preguntas</a>
        </nav>

        <!-- Acciones: Lanzador de Confeti, Selector de Tema (☀️/🌙) y Acceder -->
        <div class="flex items-center gap-2.5">
          <button
            type="button"
            id="btn-celebrate"
            aria-label="Lanzar confeti de celebración"
            class="px-2.5 py-1.5 rounded-xl bg-amber-100/80 hover:bg-amber-200/80 dark:bg-slate-900 border border-amber-300/40 dark:border-slate-800 text-amber-800 dark:text-amber-400 text-xs font-semibold flex items-center gap-1.5 shadow-sm hover:scale-105 transition cursor-pointer"
            title="¡Haz clic para celebrar!"
          >
            <span>✨</span>
            <span class="hidden sm:inline">Celebrar</span>
          </button>

          <button
            type="button"
            id="theme-toggle"
            aria-label="Alternar tema claro y oscuro"
            class="w-9 h-9 rounded-xl bg-white/90 dark:bg-slate-900 border border-amber-900/[0.08] dark:border-slate-800 text-slate-700 dark:text-amber-400 flex items-center justify-center text-sm shadow-sm hover:scale-105 transition cursor-pointer"
            title="Cambiar tema claro / oscuro"
          >
            <span class="dark:hidden">🌙</span>
            <span class="hidden dark:inline">☀️</span>
          </button>

          <a
            href="/login"
            id="nav-btn-access"
            class="px-4 py-2 text-xs font-semibold text-slate-800 dark:text-slate-200 hover:text-slate-950 dark:hover:text-white bg-white/90 dark:bg-slate-900 hover:bg-white dark:hover:bg-slate-800 border border-amber-900/[0.08] dark:border-slate-800 rounded-xl shadow-sm transition"
          >
            Acceder
          </a>
        </div>
      </div>
    </header>

    <main>
      <!-- =========================================================================
           2. HERO SECTION CÁLIDA, LUMINOSA & AMIGABLE
      ========================================================================== -->
      <section class="relative pt-12 pb-16 sm:pt-20 sm:pb-24 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto">
        <div class="text-center max-w-3xl mx-auto mb-10">
          <!-- Tag Badge Celebratorio & Cálido -->
          <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-amber-500/15 dark:bg-slate-900 border border-amber-500/30 dark:border-slate-800 text-amber-900 dark:text-amber-300 text-xs font-semibold mb-5 shadow-sm">
            <span class="text-base">🎈</span>
            <span>La forma más linda y fácil de invitar a tus seres queridos</span>
          </div>

          <!-- Main Heading -->
          <h1 class="text-3xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-slate-950 dark:text-white leading-tight sm:leading-tight mb-4">
            Invitaciones digitales que <span class="text-transparent bg-clip-text bg-gradient-to-r from-amber-600 via-orange-500 to-rose-600">emocionan</span> a tus invitados
          </h1>

          <!-- Subtitle -->
          <p class="text-sm sm:text-base text-slate-600 dark:text-slate-300 leading-relaxed mb-6 max-w-2xl mx-auto font-normal">
            Con música de fondo, confirmación RSVP en vivo, ruta en Waze y Google Maps y álbum de fotos. Olvídate del papel caro: crea tu invitación en minutos y envíala con un toque a WhatsApp.
          </p>

          <!-- Single Hero Action & Secondary Anchor -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-3.5 mb-6">
            <a
              href="/login"
              id="hero-btn-start"
              class="w-full sm:w-auto px-8 py-3.5 rounded-2xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-sm shadow-lg shadow-amber-500/25 hover:shadow-xl transition transform hover:-translate-y-0.5 flex items-center justify-center gap-2"
            >
              <span>Empezar mi Invitación</span>
              <span>✨</span>
            </a>
            <a
              href="#invitaciones"
              id="hero-btn-invitaciones"
              class="w-full sm:w-auto px-5 py-3.5 rounded-2xl text-slate-700 dark:text-slate-300 hover:text-slate-950 dark:hover:text-white text-sm font-semibold bg-white/80 dark:bg-slate-900 border border-amber-900/[0.08] dark:border-slate-800 shadow-sm transition hover:bg-white"
            >
              Ver invitaciones publicadas ↓
            </a>
          </div>

          <!-- Cost Highlight Tag & Social Proof -->
          <div class="flex flex-wrap items-center justify-center gap-3 text-xs">
            <div class="inline-flex items-center gap-2 text-slate-700 dark:text-slate-300 bg-white/80 dark:bg-slate-900/70 border border-amber-900/[0.08] dark:border-slate-800 px-4 py-1.5 rounded-full shadow-sm">
              <span>🏷️</span>
              <span>Costo único de <strong class="text-amber-700 dark:text-amber-400 font-bold text-sm">S/ 50</strong></span>
              <span class="text-slate-300 dark:text-slate-600">•</span>
              <span>Cero suscripciones ni cobros mensuales</span>
            </div>

            <!-- Avatares de Anfitriones Felices -->
            <div class="inline-flex items-center gap-2 text-slate-600 dark:text-slate-400 bg-amber-50/70 dark:bg-slate-900/60 border border-amber-200/50 dark:border-slate-800 px-3.5 py-1.5 rounded-full shadow-sm">
              <div class="flex -space-x-1.5">
                <span class="w-5 h-5 rounded-full bg-rose-400 text-white text-[9px] flex items-center justify-center font-bold">👩</span>
                <span class="w-5 h-5 rounded-full bg-amber-400 text-white text-[9px] flex items-center justify-center font-bold">👨</span>
                <span class="w-5 h-5 rounded-full bg-emerald-400 text-white text-[9px] flex items-center justify-center font-bold">🎉</span>
              </div>
              <span class="font-medium text-[11px]">+150 anfitriones felices</span>
              <span class="text-amber-500 font-bold text-xs">★★★★★</span>
            </div>
          </div>
        </div>

        <!-- =========================================================================
             PREVIEW INTERACTIVO DEL CELULAR (MUY LLAMATIVO Y AMIGABLE)
        ========================================================================== -->
        <div id="demo-interactivo" class="relative max-w-4xl mx-auto pt-4">
          <!-- Selector interactivo de tipos de evento con iconos amigables -->
          <div class="flex items-center justify-center gap-2 mb-6 flex-wrap">
            <span class="text-xs font-semibold text-slate-500 dark:text-slate-400 mr-1 hidden sm:inline">Elige tu ocasión:</span>
            <button
              type="button"
              data-type="cumple"
              class="event-preview-tab active-tab px-4 py-2 rounded-full text-xs font-bold bg-amber-500 text-slate-950 shadow-md transition cursor-pointer"
            >
              🎂 Cumpleaños
            </button>
            <button
              type="button"
              data-type="boda"
              class="event-preview-tab px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-amber-900/[0.08] dark:border-slate-800 hover:border-amber-500 transition cursor-pointer shadow-sm"
            >
              💍 Boda
            </button>
            <button
              type="button"
              data-type="quince"
              class="event-preview-tab px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-amber-900/[0.08] dark:border-slate-800 hover:border-amber-500 transition cursor-pointer shadow-sm"
            >
              👑 Quinceañero
            </button>
            <button
              type="button"
              data-type="baby"
              class="event-preview-tab px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-amber-900/[0.08] dark:border-slate-800 hover:border-amber-500 transition cursor-pointer shadow-sm"
            >
              🍼 Baby Shower
            </button>
          </div>

          <!-- Contenedor del Preview con pills flotantes decorativos -->
          <div class="relative bg-gradient-to-b from-white/95 via-amber-50/40 to-white/95 dark:from-slate-900/60 dark:to-slate-900/40 border border-amber-900/[0.08] dark:border-slate-800/80 rounded-3xl p-6 sm:p-10 backdrop-blur-md shadow-xl flex flex-col md:flex-row items-center justify-center gap-10">
            
            <!-- Pill flotante Izquierda (Desktop) -->
            <div class="hidden lg:flex flex-col gap-4 absolute -left-8 top-1/4 pointer-events-none z-20">
              <div class="animate-float-slow bg-white dark:bg-slate-900/90 border border-amber-900/[0.08] dark:border-slate-800 rounded-2xl p-3 shadow-lg flex items-center gap-3 backdrop-blur-md">
                <span class="w-8 h-8 rounded-xl bg-amber-100 dark:bg-amber-900/40 text-amber-700 dark:text-amber-400 flex items-center justify-center text-sm font-bold">🎵</span>
                <div>
                  <p class="text-xs font-bold text-slate-900 dark:text-white">Música Elegida</p>
                  <p class="text-[10px] text-slate-500">Reproduce tu tema favorito</p>
                </div>
              </div>

              <div class="animate-float-reverse bg-white dark:bg-slate-900/90 border border-amber-900/[0.08] dark:border-slate-800 rounded-2xl p-3 shadow-lg flex items-center gap-3 backdrop-blur-md">
                <span class="w-8 h-8 rounded-xl bg-emerald-100 dark:bg-emerald-900/40 text-emerald-700 dark:text-emerald-400 flex items-center justify-center text-sm font-bold">🗺️</span>
                <div>
                  <p class="text-xs font-bold text-slate-900 dark:text-white">Waze & Maps</p>
                  <p class="text-[10px] text-slate-500">Nadie se pierde al llegar</p>
                </div>
              </div>
            </div>

            <!-- Pill flotante Derecha (Desktop) -->
            <div class="hidden lg:flex flex-col gap-4 absolute -right-8 bottom-1/4 pointer-events-none z-20">
              <div class="animate-float-slow bg-white dark:bg-slate-900/90 border border-amber-900/[0.08] dark:border-slate-800 rounded-2xl p-3 shadow-lg flex items-center gap-3 backdrop-blur-md">
                <span class="w-8 h-8 rounded-xl bg-rose-100 dark:bg-rose-900/40 text-rose-700 dark:text-rose-400 flex items-center justify-center text-sm font-bold">💌</span>
                <div>
                  <p class="text-xs font-bold text-slate-900 dark:text-white">RSVP Inteligente</p>
                  <p class="text-[10px] text-slate-500">Directo a tu WhatsApp</p>
                </div>
              </div>

              <div class="animate-float-reverse bg-white dark:bg-slate-900/90 border border-amber-900/[0.08] dark:border-slate-800 rounded-2xl p-3 shadow-lg flex items-center gap-3 backdrop-blur-md">
                <span class="w-8 h-8 rounded-xl bg-purple-100 dark:bg-purple-900/40 text-purple-700 dark:text-purple-400 flex items-center justify-center text-sm font-bold">📸</span>
                <div>
                  <p class="text-xs font-bold text-slate-900 dark:text-white">Álbum de Recuerdos</p>
                  <p class="text-[10px] text-slate-500">Fotos en alta definición</p>
                </div>
              </div>
            </div>

            <!-- Celular Interactivo Ultra Detallado -->
            <div class="relative w-[275px] sm:w-[305px] rounded-[38px] bg-slate-950 p-2.5 shadow-2xl border-4 border-slate-800 shrink-0">
              <!-- Notch & Parlante -->
              <div class="absolute top-3.5 left-1/2 -translate-x-1/2 w-24 h-3.5 bg-slate-900 rounded-full z-20 flex items-center justify-center">
                <div class="w-3 h-1 bg-slate-700 rounded-full"></div>
              </div>

              <!-- Phone Screen Content -->
              <div class="relative rounded-[30px] overflow-hidden bg-slate-900 border border-slate-800/80 aspect-[9/18.5] flex flex-col justify-between text-center p-3.5 text-white">
                
                <!-- Notificación Toast interactiva cuando prueban el RSVP -->
                <div
                  id="mockup-rsvp-toast"
                  class="hidden absolute top-12 left-3 right-3 z-30 bg-emerald-500 text-slate-950 p-2.5 rounded-xl shadow-xl font-bold text-xs transform transition-all duration-300"
                >
                  <div class="flex items-center gap-2 justify-center">
                    <span>🎉</span>
                    <span>¡Asistencia Confirmada!</span>
                  </div>
                  <p class="text-[10px] text-emerald-950 font-normal mt-0.5">Notificación enviada al WhatsApp del anfitrión</p>
                </div>

                <!-- Cover Card Dinámico -->
                <div
                  id="mockup-cover"
                  class="relative rounded-2xl overflow-hidden h-36 bg-gradient-to-br from-amber-500 to-rose-600 border border-white/20 flex flex-col justify-between p-3 text-white transition-all duration-500 shadow-md"
                >
                  <div class="flex justify-between items-center text-[10px]">
                    <div class="px-2 py-0.5 rounded bg-black/40 backdrop-blur font-medium flex items-center gap-1">
                      <span class="inline-flex gap-0.5 items-end h-3 text-amber-300">
                        <span class="eq-bar"></span>
                        <span class="eq-bar"></span>
                        <span class="eq-bar"></span>
                        <span class="eq-bar"></span>
                      </span>
                      <span class="text-[9px]">Música</span>
                    </div>
                    <span id="mockup-date" class="px-2.5 py-0.5 rounded bg-amber-500 text-slate-950 font-bold shadow-sm">25 OCT</span>
                  </div>
                  <div>
                    <span id="mockup-badge" class="text-[9px] font-extrabold tracking-wider uppercase text-amber-200 block mb-0.5">🎂 CUMPLEAÑOS</span>
                    <h3 id="mockup-title" class="text-base font-bold text-white leading-tight">¡Mis 28 Años!</h3>
                    <p id="mockup-subtitle" class="text-[11px] opacity-90">Edgar Lázaro</p>
                  </div>
                </div>

                <!-- Cuenta Regresiva Realista con Segundero Animado -->
                <div class="bg-slate-950/80 border border-slate-800/80 rounded-xl p-2 my-2 shadow-inner">
                  <div class="flex items-center justify-between px-1 mb-1">
                    <span class="text-[9px] text-amber-400 font-semibold uppercase tracking-wider">⏳ Faltan solo</span>
                    <span class="text-[8px] text-emerald-400 font-mono">EN VIVO</span>
                  </div>
                  <div class="grid grid-cols-4 gap-1 text-center">
                    <div class="bg-slate-900 rounded p-1">
                      <span class="text-xs font-bold text-white block">14</span>
                      <span class="text-[7px] text-slate-400 uppercase">Días</span>
                    </div>
                    <div class="bg-slate-900 rounded p-1">
                      <span class="text-xs font-bold text-white block">08</span>
                      <span class="text-[7px] text-slate-400 uppercase">Hrs</span>
                    </div>
                    <div class="bg-slate-900 rounded p-1">
                      <span class="text-xs font-bold text-white block">42</span>
                      <span class="text-[7px] text-slate-400 uppercase">Min</span>
                    </div>
                    <div class="bg-slate-900 rounded p-1">
                      <span id="mockup-seconds" class="text-xs font-bold text-amber-400 block font-mono">19</span>
                      <span class="text-[7px] text-slate-400 uppercase">Seg</span>
                    </div>
                  </div>
                </div>

                <!-- Acciones interactivas en el mockup -->
                <div class="space-y-1.5 text-[10px]">
                  <div class="p-2 bg-slate-950/60 border border-slate-800/40 rounded-lg flex items-center justify-between text-slate-300">
                    <span id="mockup-location" class="truncate pr-1 text-[9px]">📍 Villa Jardín, Lima</span>
                    <span class="text-amber-400 font-semibold shrink-0 text-[9px] bg-amber-950/40 px-1.5 py-0.5 rounded border border-amber-500/20">Waze / Maps</span>
                  </div>
                  
                  <!-- Botón Interactivo para probar RSVP -->
                  <button
                    type="button"
                    id="mockup-rsvp-btn"
                    class="w-full py-2.5 rounded-xl bg-gradient-to-r from-amber-500 to-amber-600 hover:from-amber-400 hover:to-amber-500 text-slate-950 font-bold text-[11px] shadow-md transition transform active:scale-95 cursor-pointer flex items-center justify-center gap-1"
                  >
                    <span>Confirmar Asistencia (RSVP)</span>
                    <span>💌</span>
                  </button>
                  <p class="text-[8px] text-slate-400">↑ Haz clic para probar cómo responde</p>
                </div>

                <p class="text-[9px] text-slate-400 mt-1 font-mono">
                  freeloader.artizaro.com/[tu-evento]
                </p>
              </div>
            </div>

            <!-- Destacados al costado del mockup -->
            <div class="flex-1 space-y-4 max-w-sm text-left">
              <div class="p-4 rounded-2xl bg-white/90 dark:bg-slate-950/40 border border-amber-900/[0.08] dark:border-slate-800/60 shadow-sm hover:shadow-md transition">
                <div class="flex items-center gap-2.5 mb-1.5">
                  <span class="w-7 h-7 rounded-lg bg-amber-100 dark:bg-amber-950/60 text-amber-700 dark:text-amber-400 flex items-center justify-center text-sm font-bold">🎵</span>
                  <h4 class="text-xs font-bold text-slate-900 dark:text-white">Música con botón flotante</h4>
                </div>
                <p class="text-xs text-slate-600 dark:text-slate-400 leading-relaxed">
                  Tus invitados escuchan tu canción de fondo elegida al abrir el enlace, con opción para pausar o subir el volumen.
                </p>
              </div>

              <div class="p-4 rounded-2xl bg-white/90 dark:bg-slate-950/40 border border-amber-900/[0.08] dark:border-slate-800/60 shadow-sm hover:shadow-md transition">
                <div class="flex items-center gap-2.5 mb-1.5">
