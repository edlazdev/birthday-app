    <!-- Interactive Script: Confetti, Theme Switcher, Countdown, Audio Synth, Savings Calculator & RSVP Demo -->
    <script is:inline>
      // 1. Alternador de Tema Claro / Oscuro con guardado en localStorage
      const toggleBtn = document.getElementById('theme-toggle');
      toggleBtn?.addEventListener('click', () => {
        const isDark = document.documentElement.classList.toggle('dark');
        localStorage.setItem('freeloader-theme', isDark ? 'dark' : 'light');
      });

      // 2. Confeti Festivo con Canvas (Ligero y sin librerías externas)
      const confettiCanvas = document.getElementById('confetti-canvas');
      const ctx = confettiCanvas?.getContext('2d');
      let particles = [];
      let isAnimating = false;

      function resizeConfetti() {
        if (!confettiCanvas) return;
        confettiCanvas.width = window.innerWidth;
        confettiCanvas.height = window.innerHeight;
      }
      window.addEventListener('resize', resizeConfetti);
      resizeConfetti();

      function launchConfetti() {
        if (!confettiCanvas || !ctx) return;
        const colors = ['#f59e0b', '#ec4899', '#3b82f6', '#10b981', '#8b5cf6', '#f43f5e', '#fbbf24'];
        particles = [];
        for (let i = 0; i < 90; i++) {
          particles.push({
            x: window.innerWidth * (0.3 + Math.random() * 0.4),
            y: window.innerHeight * 0.4,
            vx: (Math.random() - 0.5) * 14,
            vy: (Math.random() - 0.9) * 16,
            size: Math.random() * 7 + 4,
            color: colors[Math.floor(Math.random() * colors.length)],
            rotation: Math.random() * 360,
            rotationSpeed: (Math.random() - 0.5) * 10,
            opacity: 1,
          });
        }
        if (!isAnimating) {
          isAnimating = true;
          animateConfetti();
        }
      }

      function animateConfetti() {
        if (!ctx || !confettiCanvas) return;
        ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        let active = false;

        particles.forEach((p) => {
          p.x += p.vx;
          p.y += p.vy;
          p.vy += 0.35; // Gravedad
          p.rotation += p.rotationSpeed;
          p.opacity -= 0.009;

          if (p.opacity > 0 && p.y < confettiCanvas.height) {
            active = true;
            ctx.save();
            ctx.globalAlpha = Math.max(0, p.opacity);
            ctx.translate(p.x, p.y);
            ctx.rotate((p.rotation * Math.PI) / 180);
            ctx.fillStyle = p.color;
            ctx.fillRect(-p.size / 2, -p.size / 2, p.size, p.size * 1.5);
            ctx.restore();
          }
        });

        if (active) {
          requestAnimationFrame(animateConfetti);
        } else {
          isAnimating = false;
          ctx.clearRect(0, 0, confettiCanvas.width, confettiCanvas.height);
        }
      }

      document.getElementById('btn-celebrate')?.addEventListener('click', launchConfetti);

      // 3. Selector interactivo de tipos de evento en el mockup del Hero
      const tabs = document.querySelectorAll('.event-preview-tab');
      const cover = document.getElementById('mockup-cover');
      const title = document.getElementById('mockup-title');
      const subtitle = document.getElementById('mockup-subtitle');
      const badge = document.getElementById('mockup-badge');
      const date = document.getElementById('mockup-date');
      const locationEl = document.getElementById('mockup-location');

      const dataMap = {
        cumple: {
          title: '¡Mis 28 Años!',
          sub: 'Edgar Lázaro',
          badge: '🎂 CUMPLEAÑOS',
          date: '25 OCT',
          location: '📍 Villa Jardín, Lima',
          gradient: 'from-amber-500 to-rose-600',
        },
        boda: {
          title: 'Nuestra Boda',
          sub: 'María & Ronal',
          badge: '💍 BODA CIVIL & RELIGIOSA',
          date: '02 MAY',
          location: '📍 Fundo Las Palmeras, Huanchaco',
          gradient: 'from-emerald-600 to-teal-800',
        },
        quince: {
          title: 'Mis Dulces 15',
          sub: 'Valeria Nicole',
          badge: '👑 QUINCEAÑERO',
          date: '14 NOV',
          location: '📍 Salón de Eventos El Prado',
          gradient: 'from-rose-500 to-purple-600',
        },
        baby: {
          title: 'Bienvenido Thiago',
          sub: 'Baby Shower & Té',
          badge: '🍼 BABY SHOWER',
          date: '10 DIC',
          location: '📍 Terraza San Isidro',
          gradient: 'from-sky-500 to-indigo-600',
        },
      };

      tabs.forEach((tab) => {
        tab.addEventListener('click', () => {
          const type = tab.getAttribute('data-type');
          const data = dataMap[type];
          if (!data) return;

          tabs.forEach((t) => {
            t.className = 'event-preview-tab px-4 py-2 rounded-full text-xs font-bold bg-white dark:bg-slate-900 text-slate-700 dark:text-slate-300 border border-amber-900/[0.08] dark:border-slate-800 hover:border-amber-500 transition cursor-pointer shadow-sm';
          });
          tab.className = 'event-preview-tab active-tab px-4 py-2 rounded-full text-xs font-bold bg-amber-500 text-slate-950 shadow-md transition cursor-pointer';

          if (title) title.textContent = data.title;
          if (subtitle) subtitle.textContent = data.sub;
          if (badge) badge.textContent = data.badge;
          if (date) date.textContent = data.date;
          if (locationEl) locationEl.textContent = data.location;
          if (cover) {
            cover.className = `relative rounded-2xl overflow-hidden h-36 bg-gradient-to-br ${data.gradient} border border-white/20 flex flex-col justify-between p-3 text-white transition-all duration-500 shadow-md`;
          }
        });
      });

      // 4. Contador regresivo que avanza cada segundo (Efecto en vivo)
      const secEl = document.getElementById('mockup-seconds');
      let currentSec = 19;
      setInterval(() => {
        if (secEl) {
          currentSec = currentSec <= 0 ? 59 : currentSec - 1;
          secEl.textContent = String(currentSec).padStart(2, '0');
        }
      }, 1000);

      // 5. Botón interactivo RSVP dentro del mockup con Toast amigable
      const rsvpBtn = document.getElementById('mockup-rsvp-btn');
      const rsvpToast = document.getElementById('mockup-rsvp-toast');
      rsvpBtn?.addEventListener('click', () => {
        if (!rsvpToast) return;
        rsvpToast.classList.remove('hidden');
        launchConfetti();
        setTimeout(() => {
          rsvpToast.classList.add('hidden');
        }, 3200);
      });


      // 7. Mini Chime Web Audio (Sin descargar archivos externos)
      const chimeBtn = document.getElementById('btn-play-chime');
      const chimeIcon = document.getElementById('chime-icon');
      const chimeText = document.getElementById('chime-text');
      let audioCtx = null;

      function playCelebrationChime() {
        try {
          if (!audioCtx) {
            audioCtx = new (window.AudioContext || window.webkitAudioContext)();
          }
          if (audioCtx.state === 'suspended') {
            audioCtx.resume();
          }

          const notes = [523.25, 659.25, 783.99, 1046.50]; // Do, Mi, Sol, Do agudo
          notes.forEach((freq, idx) => {
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(freq, audioCtx.currentTime + idx * 0.12);

            gain.gain.setValueAtTime(0.18, audioCtx.currentTime + idx * 0.12);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + idx * 0.12 + 0.5);

            osc.connect(gain);
            gain.connect(audioCtx.destination);

            osc.start(audioCtx.currentTime + idx * 0.12);
            osc.stop(audioCtx.currentTime + idx * 0.12 + 0.5);
          });

          if (chimeIcon && chimeText) {
            chimeIcon.textContent = '🎶';
            chimeText.textContent = '¡Sonando acorde alegre!';
            setTimeout(() => {
              chimeIcon.textContent = '🔔';
              chimeText.textContent = 'Escuchar sonido festivo de muestra';
            }, 1200);
          }
        } catch (e) {
          console.log('Audio not supported or permitted', e);
        }
      }

      chimeBtn?.addEventListener('click', playCelebrationChime);
    </script>
  </body>
