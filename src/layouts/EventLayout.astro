---
import FontLoader from "@/components/FontLoader.astro";
import VolumeButton from "@/components/VolumeButton.tsx";
import type { EventLayoutProps } from "@/types";
import { getEventImagePath } from "@/utils/images";
import {
  getVideoConfig,
  getYoutubeEmbedUrl,
  getThemeColor,
  getThemeInjectCSS,
  getOgImageUrl,
  getFullUrl,
} from "@/utils/layout";
import "../styles/global.css";
import "../styles/theme.css";

const { eventData } = Astro.props;
const currentPath = Astro.url.pathname;
const isAlbumPage = currentPath.includes("/album");

// Cover siempre según slug (se usa cuando no hay video o showVideoBackground es false)
const coverImagePath = getEventImagePath(eventData.slug, "cover.jpg");

// Video: solo si showVideoBackground !== false y hay config
let videoConfig = getVideoConfig(eventData, isAlbumPage);
if (eventData.showVideoBackground === false) videoConfig = null;
const youtubeUrl = videoConfig ? getYoutubeEmbedUrl(videoConfig) : "";

// URLs y meta
const fullUrl = getFullUrl(currentPath);
const ogImageUrl = getOgImageUrl(eventData.slug);
const pageTitle = isAlbumPage
  ? `Álbum - ${eventData.celebrant}`
  : `${eventData.celebrant} - ${eventData.title} ${eventData.age} ${eventData.afterAge ?? ""}`;
const pageDescription = isAlbumPage
  ? `Mira las fotos del álbum de ${eventData.celebrant}`
  : `${eventData.tagline ?? `Invitación para celebrar ${eventData.title.toLowerCase()} ${eventData.age} ${eventData.afterAge ?? ""} de ${eventData.celebrant}`}. ${eventData.date} a las ${eventData.time}. ${eventData.address}`;

// Tema
const themeColor = getThemeColor(eventData);
const themeCSS = getThemeInjectCSS(eventData);
---

<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={fullUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:secure_url" content={ogImageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`Vista previa de ${eventData.celebrant}`} />
    <meta property="og:image:url" content={ogImageUrl} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:site_name" content="Invitación de Cumpleaños" />

    <meta name="format-detection" content="telephone=no" />
    <meta name="theme-color" content={themeColor} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <link rel="image_src" href={ogImageUrl} />
    <link rel="canonical" href={fullUrl} />
    {themeCSS && <style set:html={themeCSS} />}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={fullUrl} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:src" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={`Vista previa de ${eventData.celebrant}`} />

    <FontLoader titleFont={eventData.fonts.title} textFont={eventData.fonts.text} />

    {videoConfig && (
      <script is:inline>
        if (!window.YT) {
          const tag = document.createElement("script");
          tag.src = "https://www.youtube.com/iframe_api";
          const first = document.getElementsByTagName("script")[0];
          if (first?.parentNode) first.parentNode.insertBefore(tag, first);
        }
      </script>
    )}
  </head>
  <body class={`theme-${eventData.slug}`}>
    {videoConfig ? (
      <>
        <div class="background-video-container">
          <iframe
            id={`yt-background-${videoConfig.youtubeId}`}
            class="background-video"
            src={youtubeUrl}
            frameborder="0"
            allow="autoplay; encrypted-media; accelerometer; gyroscope; picture-in-picture"
            allowfullscreen
            aria-hidden="true"
            loading="eager"
          />
        </div>
        <VolumeButton client:load videoId={videoConfig.youtubeId} initialMuted={videoConfig.muted} />
      </>
    ) : (
      <div class="background-image" style={`background-image: url('${coverImagePath}');`} />
    )}
    <slot />
  </body>
</html>

<style>
  body {
    position: relative;
    min-height: 100vh;
    overflow-x: hidden;
  }

  .background-video-container {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }

  .background-video {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 100vw;
    height: 100vh;
    min-width: 100%;
    min-height: 100%;
    transform: translate(-50%, -50%);
    object-fit: cover;
    pointer-events: none;
  }

  @media (min-aspect-ratio: 16/9) {
    .background-video {
      width: 100vw;
      height: 56.25vw;
    }
  }

  @media (max-aspect-ratio: 16/9) {
    .background-video {
      width: 177.78vh;
      height: 100vh;
    }
  }

  .background-image {
    position: fixed;
    inset: 0;
    z-index: -1;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  @media (min-width: 768px) {
    .background-image {
      background-attachment: fixed;
    }
  }

  :global(.volume-button) {
    position: fixed;
    bottom: 1.5rem;
    right: 1.5rem;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    border: 2px solid var(--primary, #ff9800);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 1000;
    transition: all 0.3s ease;
    box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
  }

  :global(.volume-button:hover) {
    background: var(--primary, #ff9800);
    transform: scale(1.1);
    box-shadow: 0 6px 12px rgba(0, 0, 0, 0.2);
  }

  :global(.volume-button:hover .volume-icon) {
    color: white;
  }

  :global(.volume-icon) {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--primary, #ff9800);
    transition: color 0.3s ease;
  }

  @media (min-width: 768px) {
    :global(.volume-button) {
      width: 3.5rem;
      height: 3.5rem;
      bottom: 2rem;
      right: 2rem;
    }
    :global(.volume-icon) {
      width: 1.75rem;
      height: 1.75rem;
    }
  }
</style>
